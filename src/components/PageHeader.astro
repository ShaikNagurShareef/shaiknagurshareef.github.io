---
/** Page title block. Actions (buttons) go in the default slot; `meta` slot sits under the lead. */
interface Props { title: string; lead?: string }
const { title, lead } = Astro.props;
---
<header class="container-page pb-10 pt-12 md:pb-14 md:pt-20">
  <h1 class="text-[2.25rem] sm:text-[2.75rem]">{title}</h1>
  {lead && <p class="mt-4 max-w-[62ch] text-[1.0625rem] leading-relaxed text-ink-2">{lead}</p>}
  <slot name="meta" />
  {Astro.slots.has("default") && <div class="mt-7 flex flex-wrap gap-2"><slot /></div>}
</header>
