---
interface Props { eyebrow?: string; title: string; lead?: string }
const { eyebrow, title, lead } = Astro.props;
---
<header class="border-b border-border">
  <div class="container-page py-12 md:py-16">
    {eyebrow && <p class="eyebrow">{eyebrow}</p>}
    <h1 class:list={["text-4xl font-semibold sm:text-5xl", eyebrow && "mt-3"]}>{title}</h1>
    {lead && <p class="mt-4 text-lg text-ink-2 prose-measure">{lead}</p>}
    <slot name="meta" />
    <slot />
  </div>
</header>
