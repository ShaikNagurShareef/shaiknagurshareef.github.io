---
/** Profile links as labelled text links (no unlabeled icon circles). `keys` picks and orders them. */
import Icon from "./Icon.astro";
interface Props { links: Record<string, string | null>; keys?: string[]; class?: string }

const LABEL: Record<string, string> = {
  scholar: "Google Scholar", orcid: "ORCID", openreview: "OpenReview", github: "GitHub",
  linkedin: "LinkedIn", huggingface: "Hugging Face", researchgate: "ResearchGate",
  webofscience: "Web of Science", kaggle: "Kaggle", medium: "Medium",
};
const { links, keys = ["scholar", "orcid", "openreview", "github", "linkedin", "huggingface"], class: cls } = Astro.props;
const shown = keys.filter((k) => links[k]);
---
<ul class:list={["flex flex-wrap gap-x-5 gap-y-2 text-sm", cls]} aria-label="Profiles">
  {shown.map((k) => (
    <li>
      <a href={links[k]!} target="_blank" rel="noopener me" class="link-quiet font-medium">
        {LABEL[k]}
      </a>
    </li>
  ))}
</ul>
