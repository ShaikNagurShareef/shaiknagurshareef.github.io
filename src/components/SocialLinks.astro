---
/** Profile links: brand icon + label. `keys` picks and orders them. */
import Icon from "./Icon.astro";
import { PROFILE } from "../lib/profiles";
interface Props { links: Record<string, string | null>; keys?: string[]; class?: string }

const { links, keys = ["scholar", "orcid", "openreview", "github", "linkedin", "huggingface"], class: cls } = Astro.props;
const shown = keys.filter((k) => links[k]);
---
<ul class:list={["flex flex-wrap gap-1.5", cls]} aria-label="Profiles">
  {shown.map((k) => {
    const p = PROFILE[k];
    return (
      <li>
        <a href={links[k]!} target="_blank" rel="noopener me" class="profile-chip">
          {p.brand ? <Icon brand={p.brand} size={15} /> : <Icon name={p.icon!} size={16} />}
          <span>{p.label}</span>
        </a>
      </li>
    );
  })}
</ul>

<style>
  .profile-chip {
    display: inline-flex; align-items: center; gap: 0.4rem; height: 2.25rem; padding-inline: 0.65rem;
    border: 1px solid var(--border); border-radius: 999px; background: var(--surface);
    font-size: 0.875rem; font-weight: 500; color: var(--ink-2); text-decoration: none;
    transition: border-color 150ms, color 150ms, transform 150ms, box-shadow 150ms;
  }
  .profile-chip :global(svg) { color: var(--muted); transition: color 150ms; }
  .profile-chip:hover { border-color: var(--ink); color: var(--ink); transform: translateY(-1px); box-shadow: var(--shadow-sm); }
  .profile-chip:hover :global(svg) { color: var(--ink); }
</style>
