---
/**
 * Shared image viewer for any <a data-lightbox href="image" data-caption="...">. Uses a native <dialog>
 * (focus trap, Esc to close); without JS the link simply opens the image.
 */
---
<dialog data-lightbox-dialog class="lightbox" aria-label="Figure viewer">
  <figure>
    <div data-lightbox-media></div>
    <figcaption data-lightbox-caption></figcaption>
  </figure>
  <div class="lightbox-bar">
    <a data-lightbox-open target="_blank" rel="noopener" class="lightbox-btn">Open full size</a>
    <button type="button" data-lightbox-close class="lightbox-btn" aria-label="Close">Close ✕</button>
  </div>
</dialog>

<style>
  .lightbox {
    width: min(92vw, 1400px); max-height: 92vh; padding: 0; border: 0; border-radius: var(--radius-lg);
    background: var(--surface); color: var(--ink); box-shadow: 0 30px 80px -20px rgb(0 0 0 / 0.5);
  }
  .lightbox::backdrop { background: rgb(10 10 10 / 0.72); backdrop-filter: blur(3px); }
  .lightbox[open] { animation: lb-in 200ms cubic-bezier(0.2, 0.7, 0.2, 1); }
  @keyframes lb-in { from { opacity: 0; transform: scale(0.97); } to { opacity: 1; transform: none; } }
  .lightbox figure { margin: 0; background: #fff; }
  .lightbox :global(img) { display: block; width: 100%; max-height: calc(92vh - 7rem); object-fit: contain; padding: 1rem; }
  .lightbox figcaption { padding: 0.75rem 1.25rem; font-size: 0.9375rem; color: var(--ink-2); background: var(--surface); border-top: 1px solid var(--border); }
  .lightbox-bar { display: flex; justify-content: flex-end; gap: 0.5rem; padding: 0 1rem 1rem; background: var(--surface); }
  .lightbox-btn {
    display: inline-flex; align-items: center; height: 2.25rem; padding-inline: 0.85rem; border: 1px solid var(--border-strong);
    border-radius: var(--radius); font-size: 0.875rem; font-weight: 600; color: var(--ink); text-decoration: none; background: var(--surface);
  }
  .lightbox-btn:hover { background: var(--surface-2); }
  @media (prefers-reduced-motion: reduce) { .lightbox[open] { animation: none; } }
</style>

<script>
  const dlg = document.querySelector<HTMLDialogElement>("[data-lightbox-dialog]");
  if (dlg) {
    // The <img> is created on first open so pages never carry an empty image element.
    const media = dlg.querySelector<HTMLElement>("[data-lightbox-media]")!;
    const img = document.createElement("img");
    const cap = dlg.querySelector<HTMLElement>("[data-lightbox-caption]")!;
    const open = dlg.querySelector<HTMLAnchorElement>("[data-lightbox-open]")!;
    document.addEventListener("click", (e) => {
      const a = (e.target as HTMLElement).closest<HTMLAnchorElement>("a[data-lightbox]");
      if (!a || e.metaKey || e.ctrlKey || e.shiftKey) return;
      e.preventDefault();
      if (!img.isConnected) media.append(img);
      img.src = a.href;
      img.alt = a.dataset.caption ?? "";
      cap.textContent = a.dataset.caption ?? "";
      open.href = a.href;
      dlg.showModal();
    });
    dlg.querySelector("[data-lightbox-close]")!.addEventListener("click", () => dlg.close());
    dlg.addEventListener("click", (e) => { if (e.target === dlg) dlg.close(); });
  }
</script>
