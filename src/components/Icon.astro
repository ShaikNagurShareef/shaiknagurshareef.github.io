---
/**
 * Inline SVG icon. `name` = a lucide-static UI icon; `brand` = a simple-icons brand glyph.
 * Rendered at build time; decorative by default (aria-hidden) unless `label` is given.
 */
import { readFileSync } from "node:fs";
import { join } from "node:path";
import * as si from "simple-icons";

interface Props { name?: string; brand?: string; size?: number; label?: string; class?: string }
const { name, brand, size = 18, label, class: cls = "" } = Astro.props;
const a11y = label ? `role="img" aria-label="${label.replace(/"/g, "&quot;")}"` : `aria-hidden="true" focusable="false"`;

let svg = "";
// Brand marks that simple-icons does not ship (LinkedIn's standard "in" mark).
const EXTRA: Record<string, string> = {
  linkedin: "M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 1 1 0-4.125 2.062 2.062 0 0 1 0 4.125zM7.119 20.452H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z",
};
if (brand) {
  const key = ("si" + brand.charAt(0).toUpperCase() + brand.slice(1)) as keyof typeof si;
  const icon = (EXTRA[brand] ? { path: EXTRA[brand] } : si[key]) as { path: string } | undefined;
  if (!icon) throw new Error(`Unknown brand icon: ${brand}`);
  svg = `<svg ${a11y} class="${cls}" width="${size}" height="${size}" viewBox="0 0 24 24" fill="currentColor"><path d="${icon.path}"/></svg>`;
} else if (name) {
  const raw = readFileSync(join(process.cwd(), "node_modules/lucide-static/icons", `${name}.svg`), "utf8");
  svg = raw
    .replace(/<!--[\s\S]*?-->/g, "")
    .replace(/class="[^"]*"/, `class="${cls}" ${a11y}`)
    .replace(/width="24"/, `width="${size}"`)
    .replace(/height="24"/, `height="${size}"`)
    .trim();
} else {
  throw new Error("Icon needs `name` or `brand`");
}
---
<Fragment set:html={svg} />
