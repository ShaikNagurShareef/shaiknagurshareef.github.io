---
/**
 * A YouTube video with named clips (start and optional end, in seconds).
 * Nothing loads from YouTube until a visitor presses play: the poster is a local image, and the
 * player is the privacy-enhanced youtube-nocookie.com embed, created on demand. Without JS, each
 * clip is a plain link to the video at that time.
 */
import Icon from "./Icon.astro";

interface Clip { label: string; start: number; end?: number }
interface Props { id: string; title: string; poster: string; clips: Clip[] }
const { id, title, poster, clips } = Astro.props;

const ts = (s: number) => {
  const h = Math.floor(s / 3600), m = Math.floor((s % 3600) / 60), sec = s % 60;
  return (h ? `${h}:${String(m).padStart(2, "0")}` : String(m)) + `:${String(sec).padStart(2, "0")}`;
};
const watch = (s: number) => `https://www.youtube.com/watch?v=${id}&t=${s}s`;
---
<div class="vclips" data-vclips data-id={id} data-title={title}>
  <div class="vclips-stage">
    <button type="button" class="vclips-poster" data-clip-index="0" aria-label={`Play ${clips[0]?.label ?? title}`}>
      <img src={poster} alt="" loading="lazy" decoding="async" />
      <span class="vclips-play" aria-hidden="true"><Icon name="play" size={26} /></span>
    </button>
  </div>
  <ol class="vclips-list" aria-label={`Clips from ${title}`}>
    {clips.map((c, i) => (
      <li>
        <a href={watch(c.start)} target="_blank" rel="noopener" class="vclips-clip" data-clip-index={i}
           data-start={c.start} data-end={c.end} aria-pressed="false">
          <Icon name="play" size={13} />
          <span class="font-semibold">{c.label}</span>
          <span class="mono text-muted">{ts(c.start)}{c.end ? `–${ts(c.end)}` : ""}</span>
        </a>
        <a href={watch(c.start)} target="_blank" rel="noopener" class="vclips-ext" title="Open on YouTube at this time">
          <Icon name="arrow-up-right" size={14} /><span class="sr-only">Open {c.label} on YouTube at {ts(c.start)}</span>
        </a>
      </li>
    ))}
  </ol>
  <p class="mt-2 text-xs text-muted">Plays from YouTube (privacy-enhanced mode) when you press play. <a href={`https://www.youtube.com/watch?v=${id}`} target="_blank" rel="noopener" class="link-quiet">Full video</a></p>
</div>

<style>
  .vclips { max-width: 44rem; }
  .vclips-stage {
    position: relative; aspect-ratio: 16 / 9; overflow: hidden; border: 1px solid var(--border);
    border-radius: var(--radius-lg); background: #000; box-shadow: var(--shadow-sm);
  }
  .vclips-stage :global(iframe) { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; }
  .vclips-poster { position: absolute; inset: 0; width: 100%; height: 100%; padding: 0; border: 0; cursor: pointer; background: #000; }
  .vclips-poster img { width: 100%; height: 100%; object-fit: cover; opacity: 0.85; transition: opacity 200ms, transform 300ms cubic-bezier(0.2, 0.7, 0.2, 1); }
  .vclips-poster:hover img { opacity: 1; transform: scale(1.02); }
  .vclips-play {
    position: absolute; left: 50%; top: 50%; display: inline-flex; align-items: center; justify-content: center;
    width: 4rem; height: 4rem; margin: -2rem 0 0 -2rem; border-radius: 999px; background: rgba(10, 10, 10, 0.8); color: #fff;
    box-shadow: 0 6px 24px rgba(0, 0, 0, 0.35); transition: transform 150ms;
  }
  .vclips-poster:hover .vclips-play { transform: scale(1.06); }
  .vclips-list { display: flex; flex-wrap: wrap; gap: 0.5rem; margin-top: 0.75rem; }
  .vclips-clip {
    display: inline-flex; align-items: center; gap: 0.45rem; min-height: 2.25rem; padding: 0.3rem 0.8rem;
    border: 1px solid var(--border); border-radius: 999px; font-size: 0.875rem; color: var(--ink); text-decoration: none;
    background: var(--surface); transition: border-color 150ms, background-color 150ms, color 150ms;
  }
  .vclips-list li { display: inline-flex; align-items: center; gap: 0.25rem; }
  .vclips-clip:hover { border-color: var(--ink); }
  .vclips-ext {
    display: inline-flex; align-items: center; justify-content: center; width: 2.25rem; height: 2.25rem;
    border: 1px solid var(--border); border-radius: 999px; color: var(--ink-2); background: var(--surface);
    transition: border-color 150ms, color 150ms;
  }
  .vclips-ext:hover { border-color: var(--ink); color: var(--ink); }
  .vclips-clip[aria-pressed="true"] { background: var(--ink); border-color: var(--ink); color: var(--bg); }
  .vclips-clip[aria-pressed="true"] .text-muted { color: inherit; opacity: 0.75; }
  @media (prefers-reduced-motion: reduce) { .vclips-poster:hover img, .vclips-poster:hover .vclips-play { transform: none; } }
</style>

<script>
  for (const root of document.querySelectorAll<HTMLElement>("[data-vclips]")) {
    const stage = root.querySelector<HTMLElement>(".vclips-stage")!;
    const clips = [...root.querySelectorAll<HTMLAnchorElement>(".vclips-clip")];
    const play = (i: number) => {
      const c = clips[i];
      if (!c) return;
      const p = new URLSearchParams({ start: c.dataset.start!, autoplay: "1", rel: "0", modestbranding: "1", playsinline: "1" });
      if (c.dataset.end) p.set("end", c.dataset.end);
      const frame = document.createElement("iframe");
      frame.src = `https://www.youtube-nocookie.com/embed/${root.dataset.id}?${p}`;
      frame.title = `${root.dataset.title}: ${c.querySelector(".font-semibold")?.textContent ?? ""}`;
      frame.allow = "autoplay; encrypted-media; picture-in-picture; fullscreen";
      frame.referrerPolicy = "strict-origin-when-cross-origin";
      frame.allowFullscreen = true;
      stage.replaceChildren(frame);
      clips.forEach((x, j) => x.setAttribute("aria-pressed", String(j === i)));
    };
    root.addEventListener("click", (e) => {
      const t = (e.target as HTMLElement).closest<HTMLElement>("[data-clip-index]");
      if (!t) return;
      e.preventDefault();
      play(Number(t.dataset.clipIndex));
    });
  }
</script>
