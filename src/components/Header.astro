---
import Icon from "./Icon.astro";
import { NAV, isActive } from "../lib/nav";
const path = Astro.url.pathname;
---
<header data-site-header class="site-header sticky top-0 z-40 border-b border-border bg-bg/90 backdrop-blur-md supports-[backdrop-filter]:bg-bg/80">
  <div class="container-page flex h-[var(--header-h)] items-center gap-6">
    <a href="/" class="flex shrink-0 items-center gap-2.5 no-underline" aria-label="Nagur Shareef Shaik, home">
      <img src="/img/avatar-96.webp" alt="" width="40" height="40" class="h-10 w-10 rounded-full bg-surface-2 object-cover ring-2 ring-accent/25" />
      <span class="font-display text-[1.1875rem] font-semibold text-ink">Nagur Shareef Shaik</span>
    </a>

    <nav aria-label="Primary" class="hidden flex-1 lg:block">
      <ul class="flex h-[var(--header-h)] items-stretch gap-1">
        {NAV.map((item) => {
          const active = isActive(path, item.href);
          return (
            <li class="flex">
              <a href={item.href} aria-current={active ? "page" : undefined} class="nav-link">{item.label}</a>
            </li>
          );
        })}
      </ul>
    </nav>

    <div class="ml-auto flex items-center gap-1">
      <button type="button" data-cmdk-open aria-label="Search the site (Ctrl or Command + K)"
              class="search-trigger">
        <Icon name="search" size={16} />
        <span class="hidden xl:inline">Search</span>
        <kbd data-cmdk-hint class="hidden xl:inline-flex">Ctrl K</kbd>
      </button>
      <button type="button" data-theme-toggle class="icon-btn" aria-label="Toggle dark mode" aria-pressed="false">
        <span data-icon-light><Icon name="moon" size={17} /></span>
        <span data-icon-dark hidden><Icon name="sun" size={17} /></span>
      </button>
      <button type="button" data-menu-button class="icon-btn lg:hidden"
              aria-label="Open menu" aria-expanded="false" aria-controls="mobile-menu">
        <span data-open-icon><Icon name="menu" size={20} /></span>
        <span data-close-icon hidden><Icon name="x" size={20} /></span>
      </button>
    </div>
  </div>

  <nav id="mobile-menu" aria-label="Primary" hidden class="border-t border-border bg-bg lg:hidden">
    <ul class="container-page grid py-2">
      {NAV.map((item) => (
        <li>
          <a href={item.href} aria-current={isActive(path, item.href) ? "page" : undefined} class="mobile-link">{item.label}</a>
        </li>
      ))}
    </ul>
  </nav>
</header>

<style>
  .site-header { transition: box-shadow 160ms ease-out; }
  .site-header[data-scrolled] { box-shadow: 0 6px 20px -14px rgb(27 29 33 / 0.35); }
  .nav-link {
    position: relative; display: inline-flex; align-items: center; padding-inline: 0.75rem;
    font-size: 0.9375rem; font-weight: 600; color: var(--ink-2); text-decoration: none;
  }
  .nav-link:hover { color: var(--ink); }
  .nav-link[aria-current="page"] { color: var(--accent-ink); }
  .nav-link[aria-current="page"]::after {
    content: ""; position: absolute; left: 0.75rem; right: 0.75rem; bottom: -1px; height: 3px;
    background: var(--accent); border-radius: 2px 2px 0 0;
  }
  .icon-btn {
    display: inline-flex; align-items: center; justify-content: center; width: 2.25rem; height: 2.25rem;
    border-radius: var(--radius); color: var(--ink-2);
  }
  .icon-btn:hover { background: var(--surface-2); color: var(--ink); }
  @media (min-width: 1024px) { [data-menu-button] { display: none; } }
  .search-trigger {
    display: inline-flex; align-items: center; gap: 0.5rem; height: 2.25rem; padding-inline: 0.6rem;
    border-radius: var(--radius); color: var(--ink-2); font-size: 0.875rem;
  }
  .search-trigger:hover { background: var(--surface-2); color: var(--ink); }
  @media (min-width: 1280px) {
    .search-trigger { width: 13rem; padding-inline: 0.7rem 0.4rem; border: 1px solid var(--border); background: var(--surface-2); color: var(--muted); }
    .search-trigger:hover { border-color: var(--border-strong); background: var(--surface-2); color: var(--ink-2); }
    .search-trigger kbd { margin-left: auto; }
  }
  .search-trigger kbd {
    align-items: center; height: 1.375rem; padding-inline: 0.35rem; border: 1px solid var(--border);
    border-radius: var(--radius-sm); background: var(--surface); font-size: 0.6875rem; color: var(--muted);
  }
  .mobile-link {
    display: block; padding: 0.7rem 0; font-weight: 500; color: var(--ink-2); text-decoration: none;
    border-bottom: 1px solid var(--border);
  }
  li:last-child > .mobile-link { border-bottom: 0; }
  .mobile-link[aria-current="page"] { color: var(--ink); box-shadow: inset 2px 0 0 var(--accent); padding-left: 0.75rem; }
</style>

<script>
  const root = document.documentElement;
  const toggle = document.querySelector<HTMLButtonElement>("[data-theme-toggle]");
  const paint = () => {
    const dark = root.dataset.theme === "dark";
    toggle?.setAttribute("aria-pressed", String(dark));
    toggle?.setAttribute("aria-label", dark ? "Switch to light mode" : "Switch to dark mode");
    toggle?.querySelector<HTMLElement>("[data-icon-light]")?.toggleAttribute("hidden", dark);
    toggle?.querySelector<HTMLElement>("[data-icon-dark]")?.toggleAttribute("hidden", !dark);
  };
  toggle?.addEventListener("click", () => {
    const next = root.dataset.theme === "dark" ? "light" : "dark";
    root.dataset.theme = next;
    try { localStorage.setItem("theme", next); } catch { /* storage unavailable */ }
    paint();
  });
  paint();

  // Show the right shortcut hint on Apple platforms.
  if (/Mac|iPhone|iPad/.test(navigator.userAgent)) {
    const hint = document.querySelector<HTMLElement>("[data-cmdk-hint]");
    if (hint) hint.textContent = "⌘K";
  }

  // Soft shadow under the header once the page is scrolled.
  const header = document.querySelector<HTMLElement>("[data-site-header]");
  const onScroll = () => header?.toggleAttribute("data-scrolled", scrollY > 4);
  addEventListener("scroll", onScroll, { passive: true });
  onScroll();

  const menuBtn = document.querySelector<HTMLButtonElement>("[data-menu-button]");
  const menu = document.getElementById("mobile-menu");
  const setMenu = (open: boolean) => {
    if (!menuBtn || !menu) return;
    menu.hidden = !open;
    menuBtn.setAttribute("aria-expanded", String(open));
    menuBtn.setAttribute("aria-label", open ? "Close menu" : "Open menu");
    menuBtn.querySelector<HTMLElement>("[data-open-icon]")?.toggleAttribute("hidden", open);
    menuBtn.querySelector<HTMLElement>("[data-close-icon]")?.toggleAttribute("hidden", !open);
  };
  menuBtn?.addEventListener("click", () => setMenu(menu?.hidden ?? true));
  document.addEventListener("keydown", (e) => { if (e.key === "Escape" && menu && !menu.hidden) { setMenu(false); menuBtn?.focus(); } });
</script>
