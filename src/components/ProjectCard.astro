---
import { ym } from "../lib/format";
import Icon from "./Icon.astro";
interface Props {
  project: { id: string; data: { title: string; stack: string[]; description: string; links: { label: string; url: string }[]; date: string; tags: string[] } };
}
const { project } = Astro.props;
const d = project.data;
---
<article id={project.id} class="project card flex h-full flex-col p-5" data-spotlight data-project data-tags={d.tags.join(" ")}>
  <div class="flex items-baseline justify-between gap-3">
    <h3 class="text-[1.1875rem] font-semibold">{d.title}</h3>
    <span class="mono shrink-0 text-muted">{ym(d.date)}</span>
  </div>
  <p class="mt-2 flex-1 text-sm leading-relaxed text-ink-2">{d.description}</p>
  <p class="mt-4 text-xs leading-relaxed text-muted"><span class="sr-only">Stack: </span>{d.stack.slice(0, 6).join(" · ")}</p>
  {d.links.length > 0 && (
    <div class="mt-4 flex flex-wrap gap-2 border-t border-border pt-3 text-sm">
      {d.links.map((l) => (
        <a href={l.url} target="_blank" rel="noopener" class="proj-link">
          {l.label === "GitHub" ? <Icon brand="github" size={15} /> : <Icon name={l.label === "Demo" ? "eye" : "external-link"} size={16} />}
          {l.label === "Demo" ? "View demo" : l.label}<span class="sr-only"> for {d.title}</span>
        </a>
      ))}
    </div>
  )}
</article>

<style>
  .proj-link {
    display: inline-flex; align-items: center; gap: 0.4rem; height: 2rem; padding-inline: 0.7rem;
    border: 1px solid var(--border); border-radius: 999px; font-size: 0.875rem; font-weight: 600;
    color: var(--ink); text-decoration: none; transition: border-color 150ms, background-color 150ms;
  }
  .proj-link:hover { border-color: var(--ink); background: var(--surface-2); }
  .project { transition: border-color 120ms, box-shadow 160ms, transform 160ms; }
  .project:hover { border-color: var(--border-strong); box-shadow: var(--shadow); transform: translateY(-1px); }
  @media (prefers-reduced-motion: reduce) { .project:hover { transform: none; } }
</style>
