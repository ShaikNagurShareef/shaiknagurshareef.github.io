---
import { ym } from "../lib/format";
import Icon from "./Icon.astro";
interface Props {
  project: { id: string; data: { title: string; stack: string[]; description: string; links: { label: string; url: string }[]; date: string; tags: string[] } };
}
const { project } = Astro.props;
const d = project.data;
---
<article id={project.id} class="card flex h-full flex-col p-5" data-project data-tags={d.tags.join(" ")}>
  <div class="flex items-start justify-between gap-3">
    <h3 class="text-xl font-semibold">{d.title}</h3>
    <span class="shrink-0 text-xs text-muted">{ym(d.date)}</span>
  </div>
  <p class="mt-2 flex-1 text-[0.9375rem] text-ink-2">{d.description}</p>
  <ul class="mt-4 flex flex-wrap gap-1.5" aria-label="Tech stack">
    {d.stack.slice(0, 6).map((s) => <li class="chip">{s}</li>)}
  </ul>
  <div class="mt-4 flex flex-wrap gap-3 text-sm font-semibold">
    {d.links.map((l) => (
      <a href={l.url} target="_blank" rel="noopener" class="inline-flex items-center gap-1 no-underline hover:underline">
        {l.label}<Icon name="arrow-up-right" size={14} /><span class="sr-only"> for {d.title}</span>
      </a>
    ))}
  </div>
</article>
