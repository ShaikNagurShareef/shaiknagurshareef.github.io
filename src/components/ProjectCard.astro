---
import { ym } from "../lib/format";
import Icon from "./Icon.astro";
interface Props {
  project: { id: string; data: { title: string; stack: string[]; description: string; links: { label: string; url: string }[]; date: string; tags: string[] } };
}
const { project } = Astro.props;
const d = project.data;
---
<article id={project.id} class="project card flex h-full flex-col p-5" data-project data-tags={d.tags.join(" ")}>
  <div class="flex items-baseline justify-between gap-3">
    <h3 class="text-[1.1875rem] font-semibold">{d.title}</h3>
    <span class="mono shrink-0 text-muted">{ym(d.date)}</span>
  </div>
  <p class="mt-2 flex-1 text-sm leading-relaxed text-ink-2">{d.description}</p>
  <p class="mt-4 text-xs leading-relaxed text-muted"><span class="sr-only">Stack: </span>{d.stack.slice(0, 6).join(" · ")}</p>
  {d.links.length > 0 && (
    <div class="mt-4 flex flex-wrap gap-4 border-t border-border pt-3 text-sm">
      {d.links.map((l) => (
        <a href={l.url} target="_blank" rel="noopener" class="link-more">
          {l.label}<span class="sr-only"> for {d.title}</span>
        </a>
      ))}
    </div>
  )}
</article>

<style>
  .project { transition: border-color 120ms; }
  .project:hover { border-color: var(--border-strong); }
</style>
