---
import Icon from "./Icon.astro";
interface Props {
  person: { id: string; data: { name: string; role: string; photo: string | null; links: { label: string; url: string }[]; note: string | null } };
}
const { id } = Astro.props.person;
const d = Astro.props.person.data;
const initials = d.name.replace(/^Dr\.\s*/, "").split(/\s+/).filter((w) => /^[A-Z]/.test(w)).map((w) => w[0]).slice(0, 2).join("");
---
<article id={`person-${id}`} class="flex gap-4">
  {d.photo ? (
    <img src={d.photo} alt="" width="64" height="64" loading="lazy" decoding="async"
         class="h-16 w-16 shrink-0 rounded-[var(--radius)] bg-surface-2 object-cover" />
  ) : (
    <span aria-hidden="true" class="inline-flex h-16 w-16 shrink-0 items-center justify-center rounded-[var(--radius)] bg-surface-2 font-display text-lg font-semibold text-muted">{initials}</span>
  )}
  <div class="min-w-0">
    <h3 class="text-[0.9375rem] font-semibold leading-snug">{d.name}</h3>
    <p class="mt-0.5 text-sm leading-snug text-muted">{d.role}</p>
    {d.note && <p class="mt-1.5 text-sm leading-snug text-ink-2">{d.note}</p>}
    {d.links.length > 0 && (
      <ul class="mt-2 flex flex-wrap gap-x-3 gap-y-1 text-[0.8125rem]">
        {d.links.map((l) => (
          <li>
            <a href={l.url} target="_blank" rel="noopener" class="link-more !text-[0.8125rem] !text-ink-2 hover:!text-accent-ink">
              {l.label}<Icon name="arrow-up-right" size={12} class="text-muted" /><span class="sr-only"> ({d.name})</span>
            </a>
          </li>
        ))}
      </ul>
    )}
  </div>
</article>
