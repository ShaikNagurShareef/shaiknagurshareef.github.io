---
import { STATUS_LABEL, KIND_LABEL } from "../lib/format";
import Icon from "./Icon.astro";
interface Props {
  pub: { id: string; data: {
    title: string; authors: string; venue: string; year: number | null; kind: string; status: string;
    presentation: string | null; url: string | null;
    links?: { doi: string | null; official: string | null; arxiv: string | null; openreview: string | null };
  } };
  headingLevel?: "h3" | "h4";
  /** When given, renders a "Cite" disclosure with copyable BibTeX. */
  bibtex?: string;
}
const { pub, headingLevel = "h3", bibtex } = Astro.props;
const d = pub.data;
const H = headingLevel;
// Bold the owner's name in the author list (authors are plain text, so escape before injecting markup).
const escapeHtml = (s: string) => s.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;");
const authors = escapeHtml(d.authors).replace(/(Shaik, Nagur Shareef)/, "<span class=\"font-semibold text-ink\">$1</span>");
const published = d.status === "published";
const statusBadge = published ? null : d.status === "in-preparation" ? "badge" : "badge badge-info";
const search = `${d.title} ${d.authors} ${d.venue} ${d.year ?? ""}`.toLowerCase();
// Version of record, preprint and open review, in that order; fall back to the single legacy url.
const L = d.links;
type PubLink = { href: string; label: string; hint: string; icon?: string; brand?: string };
const links: PubLink[] = [];
if (L) {
  if (L.official) links.push({ href: L.official, label: "Paper", hint: L.doi ? `Published version, DOI ${L.doi}` : "Published version", icon: "file-text" });
  if (L.arxiv) links.push({ href: L.arxiv, label: "arXiv", hint: `arXiv preprint ${L.arxiv.split("/abs/")[1]}`, brand: "arxiv" });
  if (L.openreview) links.push({ href: L.openreview, label: "OpenReview", hint: "OpenReview page", icon: "message-square-text" });
} else if (d.url) {
  links.push({ href: d.url, label: "Paper", hint: "Paper", icon: "file-text" });
}
---
<article class="pub py-5" id={pub.id} data-pub data-year={d.year ?? ""} data-kind={d.kind} data-status={d.status}
         data-presentation={d.presentation ?? ""} data-search={search}>
  <H class="text-[1.125rem] font-semibold leading-snug">
    {d.url ? <a href={d.url} target="_blank" rel="noopener" class="link-plain text-ink">{d.title}</a> : d.title}
  </H>
  <p class="mt-1.5 text-sm leading-relaxed text-muted" set:html={authors} />
  <p class="mt-0.5 text-sm leading-relaxed text-ink-2">{d.venue}{d.year && published ? `, ${d.year}` : ""}</p>
  <div class="mt-2.5 flex flex-wrap items-center gap-x-3 gap-y-2 text-[0.875rem]">
    {statusBadge && <span class={statusBadge}>{STATUS_LABEL[d.status]}</span>}
    {d.presentation === "oral" && <span class="badge badge-accent">Oral</span>}
    <span class="text-muted">{KIND_LABEL[d.kind]}{d.presentation === "poster" ? " · Poster" : ""}</span>
    {links.map((l) => (
      <a href={l.href} target="_blank" rel="noopener" class="pub-action" title={l.hint}>
        {l.brand ? <Icon brand={l.brand} size={14} /> : <Icon name={l.icon!} size={15} />}{l.label}<span class="sr-only"> ({l.hint}): {d.title}</span>
      </a>
    ))}
    {bibtex && (
      <button type="button" class="pub-action" data-cite-toggle aria-expanded="false" aria-controls={`cite-${pub.id}`}>
        <Icon name="quote" size={15} />Cite<span class="sr-only"> {d.title}</span>
      </button>
    )}
  </div>
  {bibtex && (
    <div id={`cite-${pub.id}`} class="relative mt-3" hidden>
      <pre class="overflow-x-auto rounded-[var(--radius)] border border-border bg-surface-2 p-3 pr-20 font-mono text-xs leading-relaxed text-ink-2"><code>{bibtex}</code></pre>
      <button type="button" data-copy={bibtex} class="btn btn-sm absolute right-2 top-2">
        <Icon name="copy" size={13} /><span data-copy-label>Copy</span>
      </button>
    </div>
  )}
</article>

<style>
  .pub-action {
    display: inline-flex; align-items: center; gap: 0.3rem; font-weight: 500; color: var(--ink);
    text-decoration: none;
  }
  .pub-action :global(svg) { color: var(--muted); transition: color 120ms; }
  .pub-action:hover { text-decoration: underline; text-underline-offset: 0.2em; }
  .pub-action:hover :global(svg), .pub-action[aria-expanded="true"] :global(svg) { color: var(--ink); }
  .pub-action:hover, .pub-action[aria-expanded="true"] { color: var(--accent-ink); }
</style>
