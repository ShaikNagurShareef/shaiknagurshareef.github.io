---
/**
 * Ctrl/Cmd+K (or "/") search: pages, papers, projects, people, awards, experience and more, in plain language.
 * Ranks instantly in the browser (BM25 with synonyms, typo tolerance and filters read from the query,
 * src/lib/search.ts), then re-ranks with the semantic search API on the Space when it answers in time.
 * WAI-ARIA combobox + listbox inside a native <dialog> (focus trap and Esc come from the platform).
 */
import Icon from "./Icon.astro";
import { getEntry } from "astro:content";
import { SPACE_API } from "../lib/api";
const { email } = (await getEntry("profile", "me"))!.data;
---
<dialog data-cmdk data-email={email} data-api={SPACE_API} aria-label="Search the site" class="cmdk">
  <div class="flex items-center gap-3 border-b border-border px-4">
    <Icon name="search" size={18} class="shrink-0 text-muted" />
    <input data-cmdk-input type="text" role="combobox" aria-expanded="true" aria-controls="cmdk-list"
           aria-autocomplete="list" aria-label="Search or ask a question" aria-describedby="cmdk-filters"
           placeholder="Search or ask a question" autocomplete="off" spellcheck="false" maxlength="200"
           class="h-14 w-full bg-transparent text-base text-ink outline-none placeholder:text-muted" />
    <kbd class="hidden shrink-0 rounded border border-border px-1.5 py-0.5 text-xs text-muted sm:inline">Esc</kbd>
  </div>
  <div id="cmdk-filters" data-cmdk-filters class="cmdk-filters" hidden>
    <Icon name="list-filter" size={14} class="shrink-0" />
    <span data-cmdk-filter-text class="min-w-0 truncate text-ink-2"></span>
    <button type="button" data-cmdk-filter-clear class="cmdk-clear" aria-label="Clear filters">
      <Icon name="x" size={13} />Clear
    </button>
  </div>
  <ul id="cmdk-list" data-cmdk-list role="listbox" aria-label="Results" class="max-h-[min(60vh,28rem)] overflow-y-auto p-2"></ul>
  <div class="flex items-center gap-4 border-t border-border px-4 py-2 text-xs text-muted">
    <span data-cmdk-status aria-live="polite"></span>
    <span data-cmdk-ai class="cmdk-ai" title="Ranked with semantic search" hidden><Icon name="sparkles" size={12} />AI search</span>
    <span class="ml-auto hidden items-center gap-4 sm:flex">
      <span><kbd>↑</kbd> <kbd>↓</kbd> to move</span><span><kbd>Enter</kbd> to open</span><span><kbd>Esc</kbd> to close</span>
    </span>
  </div>
  <template data-cmdk-ask-icon><Icon name="message-circle" size={16} class="shrink-0 text-muted" /></template>
</dialog>

<style>
  .cmdk {
    width: min(40rem, calc(100vw - 2rem));
    margin: 12vh auto auto;
    padding: 0;
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-lg);
    background: var(--surface);
    color: var(--ink);
    box-shadow: var(--shadow);
  }
  .cmdk::backdrop { background: rgb(18 19 21 / 0.45); backdrop-filter: blur(2px); }
  .cmdk kbd { font-family: var(--font-sans); }
  .cmdk-filters {
    display: flex; align-items: center; gap: 0.5rem; min-height: 2.25rem;
    padding: 0.35rem 1rem; border-bottom: 1px solid var(--border); font-size: 0.8125rem; color: var(--muted);
  }
  .cmdk-filters[hidden], .cmdk-ai[hidden] { display: none; }
  .cmdk-clear {
    display: inline-flex; align-items: center; gap: 0.2rem; margin-left: auto; flex-shrink: 0;
    padding: 0.15rem 0.35rem; border-radius: var(--radius-sm, 4px); color: var(--ink-2);
  }
  .cmdk-clear:hover { color: var(--ink); background: var(--surface-2); }
  .cmdk-ai { display: inline-flex; align-items: center; gap: 0.25rem; color: var(--ink-2); }
  .cmdk :global([role="option"]) {
    display: flex; align-items: center; gap: 0.75rem;
    padding: 0.55rem 0.75rem; border-radius: var(--radius); cursor: pointer;
  }
  .cmdk :global([role="option"][aria-selected="true"]) { background: var(--surface-2); box-shadow: inset 2px 0 0 var(--accent); }
  .cmdk :global(.cmdk-group) {
    padding: 0.6rem 0.75rem 0.25rem; font-size: 0.7rem; font-weight: 700;
    letter-spacing: 0.1em; text-transform: uppercase; color: var(--muted);
  }
  .cmdk :global(.cmdk-type) { flex-shrink: 0; font-size: 0.75rem; color: var(--muted); }
  .cmdk :global(.cmdk-ask) { margin-top: 0.25rem; }
  .cmdk :global(.cmdk-sep) { margin: 0.25rem 0.75rem 0; border-top: 1px solid var(--border); }
</style>

<script>
  import {
    buildIndex, lexicalSearch, fuse, filterLabels, isQuestion,
    type Index, type SearchItem, type FilterKey, type Filters, type SemanticHit,
  } from "../lib/search";

  type Row = { kind: "item"; item: SearchItem } | { kind: "ask"; q: string };

  const dialog = document.querySelector<HTMLDialogElement>("[data-cmdk]")!;
  const input = dialog.querySelector<HTMLInputElement>("[data-cmdk-input]")!;
  const list = dialog.querySelector<HTMLUListElement>("[data-cmdk-list]")!;
  const status = dialog.querySelector<HTMLElement>("[data-cmdk-status]")!;
  const aiMark = dialog.querySelector<HTMLElement>("[data-cmdk-ai]")!;
  const filterBar = dialog.querySelector<HTMLElement>("[data-cmdk-filters]")!;
  const filterText = dialog.querySelector<HTMLElement>("[data-cmdk-filter-text]")!;
  const askIcon = dialog.querySelector<HTMLTemplateElement>("[data-cmdk-ask-icon]")!;

  let API = dialog.dataset.api!;
  // Local testing only: http://localhost:4321/?search_api=http://localhost:7861 (or the chat widget's chat_api).
  if (/^(localhost|127\.0\.0\.1)$/.test(location.hostname)) {
    const p = new URLSearchParams(location.search);
    const o = p.get("search_api") ?? p.get("chat_api");
    if (o) API = o.replace(/\/$/, "");
  }
  /** Semantic-only results need at least this cosine similarity (bge-small-en-v1.5) and must be close to the best hit (see fuse). */
  const FLOOR = 0.55;
  const DEBOUNCE_MS = 180, TIMEOUT_MS = 1500;

  const email = dialog.dataset.email ?? "";
  const ACTIONS: SearchItem[] = [
    { type: "Action", title: "Toggle dark mode", url: "action:theme", keywords: "theme light dark appearance" },
    { type: "Action", title: "Copy email address", subtitle: email, url: "action:email", keywords: "email contact mail" },
  ];
  const RUN: Record<string, () => void> = {
    "action:theme": () => document.querySelector<HTMLButtonElement>("[data-theme-toggle]")?.click(),
    "action:email": () => { navigator.clipboard?.writeText(email); },
  };
  const DEFAULT_ORDER = ["Page", "Action", "Document"];
  const GROUP_LABEL: Record<string, string> = { Page: "Pages", Action: "Actions", Document: "Documents" };

  let index: Index | null = null;
  let loadFailed = false;
  let rows: Row[] = [];
  let active = 0;
  /** True once the user moved the selection with the keyboard for the current query. */
  let moved = false;
  /** Filters the user cleared; they stay off while the query states the same filters. */
  let off = new Set<FilterKey>();
  let offSig = "";

  const norm = (q: string) => q.trim().toLowerCase().replace(/\s+/g, " ");
  const keyOf = (r?: Row) => (!r ? "" : r.kind === "ask" ? "ask:" : r.item.url);
  const sig = (f: Filters) => JSON.stringify(f);
  const hasChat = () => !!document.getElementById("chat-win");

  async function load() {
    if (index || loadFailed) return;
    status.textContent = "Loading…";
    try {
      const items: SearchItem[] = await (await fetch("/search-index.json")).json();
      index = buildIndex([...items, ...ACTIONS]);
    } catch {
      loadFailed = true;
      index = buildIndex(ACTIONS);
      status.textContent = "Search is unavailable right now.";
    }
  }

  /* ---------------- semantic re-ranking (optional; any failure keeps the lexical ranking) */
  const semCache = new Map<string, SemanticHit[]>();
  let timer = 0;
  let inflight: AbortController | null = null;
  let pausedUntil = 0;

  function semantic(q: string) {
    clearTimeout(timer);
    inflight?.abort();
    inflight = null;
    const key = norm(q);
    if (key.length < 3 || !/[a-z]/.test(key) || semCache.has(key) || Date.now() < pausedUntil) return;
    timer = window.setTimeout(async () => {
      const ctrl = (inflight = new AbortController());
      let timedOut = false;
      const t = setTimeout(() => { timedOut = true; ctrl.abort(); }, TIMEOUT_MS);
      try {
        const res = await fetch(`${API}/search`, {
          method: "POST", headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ q: q.trim().slice(0, 200), k: 40 }), signal: ctrl.signal,
        });
        if (!res.ok) {
          // 503 while the model loads, 429 when rate-limited, 404 before the endpoint exists.
          pausedUntil = Date.now() + (res.status === 404 ? 600_000 : res.status === 429 ? 30_000 : 10_000);
          return;
        }
        const data = await res.json();
        if (!Array.isArray(data?.results)) return;
        const hits: SemanticHit[] = data.results.filter(
          (h: unknown): h is SemanticHit => !!h && typeof (h as SemanticHit).url === "string" && typeof (h as SemanticHit).score === "number",
        );
        if (semCache.size > 100) semCache.delete(semCache.keys().next().value!);
        semCache.set(key, hits);
        if (dialog.open && norm(input.value) === key) render(true);
      } catch {
        // Superseded by newer typing or slow: try again on the next query. Network/CORS failure: back off.
        if (!ctrl.signal.aborted) pausedUntil = Date.now() + 60_000;
        else if (timedOut) pausedUntil = Date.now() + 3_000;
      } finally {
        clearTimeout(t);
        if (inflight === ctrl) inflight = null;
      }
    }, DEBOUNCE_MS);
  }

  /* ---------------- ranking */
  function compute(q: string): { rows: Row[]; labels: string[]; ai: boolean } {
    const idx = index!;
    if (!norm(q)) {
      const rows = idx.docs
        .map((d) => d.item)
        .filter((i) => DEFAULT_ORDER.includes(i.type))
        .sort((a, b) => DEFAULT_ORDER.indexOf(a.type) - DEFAULT_ORDER.indexOf(b.type))
        .map((item): Row => ({ kind: "item", item }));
      return { rows, labels: [], ai: false };
    }
    let lex = lexicalSearch(idx, q, { off });
    if (off.size && sig(lex.parsed.filters) !== offSig) {
      off = new Set();
      lex = lexicalSearch(idx, q);
    }
    let items = lex.results.map((r) => r.item);
    const hits = semCache.get(norm(q));
    if (hits) items = fuse(idx, items, hits, lex.filters, { floor: FLOOR });
    const rows: Row[] = items.map((item) => ({ kind: "item", item }));
    if (hasChat() && isQuestion(q)) rows.push({ kind: "ask", q: q.trim() });
    const labels = filterLabels(lex.parsed.filters).filter((l) => !lex.off.has(l.key)).map((l) => l.label);
    return { rows, labels, ai: !!hits };
  }

  function render(keepSelection = false) {
    if (!index) return;
    const q = input.value;
    const prev = keyOf(rows[active]);
    const out = compute(q);
    rows = out.rows;
    if (keepSelection && moved) {
      const i = rows.findIndex((r) => keyOf(r) === prev);
      active = i >= 0 ? i : 0;
      if (i < 0) moved = false;
    } else {
      active = Math.min(active, Math.max(rows.length - 1, 0));
    }

    filterBar.hidden = !out.labels.length;
    filterText.textContent = out.labels.join(" · ");
    aiMark.hidden = !out.ai;

    const grouped = !norm(q);
    list.replaceChildren();
    let group = "";
    rows.forEach((r, i) => {
      if (grouped && r.kind === "item" && r.item.type !== group) {
        group = r.item.type;
        const h = document.createElement("li");
        h.className = "cmdk-group";
        h.setAttribute("role", "presentation");
        h.textContent = GROUP_LABEL[group] ?? group;
        list.append(h);
      }
      if (r.kind === "ask" && i > 0) {
        const sep = document.createElement("li");
        sep.className = "cmdk-sep";
        sep.setAttribute("role", "presentation");
        list.append(sep);
      }
      const li = document.createElement("li");
      li.id = `cmdk-opt-${i}`;
      li.setAttribute("role", "option");
      li.setAttribute("aria-selected", String(i === active));
      li.dataset.index = String(i);
      const text = document.createElement("span");
      text.className = "min-w-0 flex-1";
      const t = document.createElement("span");
      t.className = "block truncate font-medium text-ink";
      text.append(t);
      if (r.kind === "ask") {
        li.classList.add("cmdk-ask");
        li.append(askIcon.content.cloneNode(true));
        t.textContent = `Ask the assistant: “${r.q}”`;
        li.append(text);
      } else {
        const it = r.item;
        t.textContent = it.title;
        if (it.subtitle) {
          const s = document.createElement("span");
          s.className = "block truncate text-sm text-muted";
          s.textContent = it.subtitle;
          text.append(s);
        }
        li.append(text);
        if (!grouped) {
          const type = document.createElement("span");
          type.className = "cmdk-type";
          type.textContent = it.type;
          li.append(type);
        }
        if (it.external) {
          const ext = document.createElement("span");
          ext.className = "text-xs text-muted";
          ext.textContent = "↗";
          ext.setAttribute("aria-label", "opens in a new tab");
          li.append(ext);
        }
      }
      list.append(li);
    });
    input.setAttribute("aria-activedescendant", rows.length ? `cmdk-opt-${active}` : "");
    if (rows.length) document.getElementById(`cmdk-opt-${active}`)?.scrollIntoView({ block: "nearest" });
    if (!loadFailed) {
      const n = rows.filter((r) => r.kind === "item").length;
      status.textContent = n ? `${n} result${n === 1 ? "" : "s"}` : "No results.";
    }
  }

  function move(delta: number) {
    if (!rows.length) return;
    moved = true;
    active = (active + delta + rows.length) % rows.length;
    list.querySelectorAll('[role="option"]').forEach((el, i) => el.setAttribute("aria-selected", String(i === active)));
    input.setAttribute("aria-activedescendant", `cmdk-opt-${active}`);
    document.getElementById(`cmdk-opt-${active}`)?.scrollIntoView({ block: "nearest" });
  }

  function choose(i: number) {
    const r = rows[i];
    if (!r) return;
    dialog.close();
    if (r.kind === "ask") {
      document.dispatchEvent(new CustomEvent("chat:ask", { detail: r.q }));
      return;
    }
    const it = r.item;
    if (it.type === "Action") return RUN[it.url]?.();
    if (it.external) window.open(it.url, "_blank", "noopener");
    else location.assign(it.url);
  }

  async function open() {
    if (dialog.open) return;
    input.value = "";
    active = 0; moved = false; off = new Set();
    dialog.showModal();
    input.focus();
    await load();
    render();
  }

  input.addEventListener("input", () => {
    active = 0; moved = false;
    render();
    semantic(input.value);
  });
  input.addEventListener("keydown", (e) => {
    if (e.key === "ArrowDown") { e.preventDefault(); move(1); }
    else if (e.key === "ArrowUp") { e.preventDefault(); move(-1); }
    else if (e.key === "Home" && e.ctrlKey) { e.preventDefault(); move(-active); }
    else if (e.key === "End" && e.ctrlKey) { e.preventDefault(); move(rows.length - 1 - active); }
    else if (e.key === "Enter") { e.preventDefault(); choose(active); }
  });
  list.addEventListener("click", (e) => {
    const li = (e.target as HTMLElement).closest<HTMLElement>('[role="option"]');
    if (li) choose(Number(li.dataset.index));
  });
  dialog.querySelector("[data-cmdk-filter-clear]")!.addEventListener("click", () => {
    if (!index) return;
    const lex = lexicalSearch(index, input.value);
    off = new Set<FilterKey>(["type", "year", "oral", "kind", "status"]);
    offSig = sig(lex.parsed.filters);
    active = 0; moved = false;
    render();
    input.focus();
  });
  dialog.addEventListener("click", (e) => { if (e.target === dialog) dialog.close(); }); // backdrop click
  dialog.addEventListener("close", () => { clearTimeout(timer); inflight?.abort(); });

  document.addEventListener("keydown", (e) => {
    const typing = e.target instanceof HTMLElement && (e.target.isContentEditable || /^(INPUT|TEXTAREA|SELECT)$/.test(e.target.tagName));
    if ((e.key === "k" || e.key === "K") && (e.metaKey || e.ctrlKey)) { e.preventDefault(); dialog.open ? dialog.close() : open(); }
    else if (e.key === "/" && !typing && !dialog.open) { e.preventDefault(); open(); }
  });
  document.querySelectorAll("[data-cmdk-open]").forEach((b) => b.addEventListener("click", open));
</script>
