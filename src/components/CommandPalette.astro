---
/**
 * Ctrl/Cmd+K (or "/") command palette: jump to any page, paper, project, person, document or profile.
 * WAI-ARIA combobox + listbox inside a native <dialog> (focus trap and Esc come from the platform).
 */
import Icon from "./Icon.astro";
import { getEntry } from "astro:content";
const { email } = (await getEntry("profile", "me"))!.data;
---
<dialog data-cmdk data-email={email} aria-label="Search the site" class="cmdk">
  <div class="flex items-center gap-3 border-b border-border px-4">
    <Icon name="search" size={18} class="shrink-0 text-muted" />
    <input data-cmdk-input type="text" role="combobox" aria-expanded="true" aria-controls="cmdk-list"
           aria-autocomplete="list" aria-label="Search pages, papers, projects and people"
           placeholder="Search pages, papers, projects, people…" autocomplete="off" spellcheck="false"
           class="h-14 w-full bg-transparent text-base text-ink outline-none placeholder:text-muted" />
    <kbd class="hidden shrink-0 rounded border border-border px-1.5 py-0.5 text-xs text-muted sm:inline">Esc</kbd>
  </div>
  <ul id="cmdk-list" data-cmdk-list role="listbox" aria-label="Results" class="max-h-[min(60vh,28rem)] overflow-y-auto p-2"></ul>
  <p data-cmdk-status class="px-4 pb-3 text-sm text-muted" aria-live="polite"></p>
  <div class="hidden items-center gap-4 border-t border-border px-4 py-2 text-xs text-muted sm:flex">
    <span><kbd>↑</kbd> <kbd>↓</kbd> to move</span><span><kbd>Enter</kbd> to open</span><span><kbd>Esc</kbd> to close</span>
  </div>
</dialog>

<style>
  .cmdk {
    width: min(40rem, calc(100vw - 2rem));
    margin: 12vh auto auto;
    padding: 0;
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-lg);
    background: var(--surface);
    color: var(--ink);
    box-shadow: var(--shadow);
  }
  .cmdk::backdrop { background: rgb(18 19 21 / 0.45); backdrop-filter: blur(2px); }
  .cmdk kbd { font-family: var(--font-sans); }
  .cmdk :global([role="option"]) {
    display: flex; align-items: center; gap: 0.75rem;
    padding: 0.55rem 0.75rem; border-radius: var(--radius); cursor: pointer;
  }
  .cmdk :global([role="option"][aria-selected="true"]) { background: var(--surface-2); box-shadow: inset 2px 0 0 var(--accent); }
  .cmdk :global(.cmdk-group) {
    padding: 0.6rem 0.75rem 0.25rem; font-size: 0.7rem; font-weight: 700;
    letter-spacing: 0.1em; text-transform: uppercase; color: var(--muted);
  }
</style>

<script>
  type Item = { type: string; title: string; subtitle?: string; url: string; external?: boolean; keywords?: string };
  type Action = { type: "Action"; title: string; subtitle?: string; keywords?: string; run: () => void };
  type Entry = Item | Action;
  const isAction = (e: Entry): e is Action => "run" in e;

  const dialog = document.querySelector<HTMLDialogElement>("[data-cmdk]")!;
  const input = dialog.querySelector<HTMLInputElement>("[data-cmdk-input]")!;
  const list = dialog.querySelector<HTMLUListElement>("[data-cmdk-list]")!;
  const status = dialog.querySelector<HTMLElement>("[data-cmdk-status]")!;
  let index: Item[] | null = null;
  let results: Entry[] = [];
  let active = 0;

  const email = dialog.dataset.email ?? "";
  const ACTIONS: Action[] = [
    { type: "Action", title: "Toggle dark mode", run: () => document.querySelector<HTMLButtonElement>("[data-theme-toggle]")?.click() },
    {
      type: "Action", title: "Copy email address", subtitle: email,
      run: () => navigator.clipboard?.writeText(email),
    },
  ];
  const ORDER = ["Page", "Action", "Section", "Publication", "Project", "Person", "Document", "Profile"];

  async function load() {
    if (index) return;
    status.textContent = "Loading…";
    try {
      index = await (await fetch("/search-index.json")).json();
    } catch {
      index = [];
      status.textContent = "Search is unavailable right now.";
    }
  }

  function search(q: string): Entry[] {
    const all: Entry[] = [...(index ?? []), ...ACTIONS];
    const terms = q.toLowerCase().split(/\s+/).filter(Boolean);
    if (!terms.length) return all.filter((e) => e.type === "Page" || e.type === "Action" || e.type === "Document");
    const scored: Array<[Entry, number]> = [];
    for (const e of all) {
      const title = e.title.toLowerCase();
      const hay = `${title} ${(e.subtitle ?? "").toLowerCase()} ${(e.keywords ?? "").toLowerCase()}`;
      if (!terms.every((t) => hay.includes(t))) continue;
      const q0 = terms.join(" ");
      const score = (title.startsWith(q0) ? 4 : 0) + (title.includes(q0) ? 2 : 0) + terms.filter((t) => title.includes(t)).length;
      scored.push([e, score]);
    }
    // Groups stay contiguous; the group holding the best title match comes first.
    const best = new Map<string, number>();
    for (const [e, s] of scored) best.set(e.type, Math.max(best.get(e.type) ?? 0, s));
    return scored
      .sort((a, b) =>
        best.get(b[0].type)! - best.get(a[0].type)! ||
        ORDER.indexOf(a[0].type) - ORDER.indexOf(b[0].type) ||
        b[1] - a[1])
      .slice(0, 60)
      .map(([e]) => e);
  }

  function render() {
    results = search(input.value);
    active = Math.min(active, Math.max(results.length - 1, 0));
    list.replaceChildren();
    let group = "";
    results.forEach((r, i) => {
      if (r.type !== group) {
        group = r.type;
        const h = document.createElement("li");
        h.className = "cmdk-group";
        h.setAttribute("role", "presentation");
        h.textContent = group === "Publication" ? "Publications" : group === "Person" ? "People" : `${group}s`;
        list.append(h);
      }
      const li = document.createElement("li");
      li.id = `cmdk-opt-${i}`;
      li.setAttribute("role", "option");
      li.setAttribute("aria-selected", String(i === active));
      li.dataset.index = String(i);
      const text = document.createElement("span");
      text.className = "min-w-0 flex-1";
      const t = document.createElement("span");
      t.className = "block truncate font-medium text-ink";
      t.textContent = r.title;
      text.append(t);
      if (r.subtitle) {
        const s = document.createElement("span");
        s.className = "block truncate text-sm text-muted";
        s.textContent = r.subtitle;
        text.append(s);
      }
      li.append(text);
      if (!isAction(r) && r.external) {
        const ext = document.createElement("span");
        ext.className = "text-xs text-muted";
        ext.textContent = "↗";
        ext.setAttribute("aria-label", "opens in a new tab");
        li.append(ext);
      }
      list.append(li);
    });
    input.setAttribute("aria-activedescendant", results.length ? `cmdk-opt-${active}` : "");
    if (index) status.textContent = results.length ? `${results.length} result${results.length === 1 ? "" : "s"}` : "No results.";
  }

  function move(delta: number) {
    if (!results.length) return;
    active = (active + delta + results.length) % results.length;
    list.querySelectorAll('[role="option"]').forEach((el, i) => el.setAttribute("aria-selected", String(i === active)));
    input.setAttribute("aria-activedescendant", `cmdk-opt-${active}`);
    document.getElementById(`cmdk-opt-${active}`)?.scrollIntoView({ block: "nearest" });
  }

  function choose(i: number) {
    const r = results[i];
    if (!r) return;
    dialog.close();
    if (isAction(r)) return r.run();
    if (r.external) window.open(r.url, "_blank", "noopener");
    else location.assign(r.url);
  }

  async function open() {
    if (dialog.open) return;
    input.value = "";
    active = 0;
    dialog.showModal();
    input.focus();
    await load();
    render();
  }

  input.addEventListener("input", () => { active = 0; render(); });
  input.addEventListener("keydown", (e) => {
    if (e.key === "ArrowDown") { e.preventDefault(); move(1); }
    else if (e.key === "ArrowUp") { e.preventDefault(); move(-1); }
    else if (e.key === "Enter") { e.preventDefault(); choose(active); }
  });
  list.addEventListener("click", (e) => {
    const li = (e.target as HTMLElement).closest<HTMLElement>('[role="option"]');
    if (li) choose(Number(li.dataset.index));
  });
  dialog.addEventListener("click", (e) => { if (e.target === dialog) dialog.close(); }); // backdrop click

  document.addEventListener("keydown", (e) => {
    const typing = e.target instanceof HTMLElement && (e.target.isContentEditable || /^(INPUT|TEXTAREA|SELECT)$/.test(e.target.tagName));
    if ((e.key === "k" || e.key === "K") && (e.metaKey || e.ctrlKey)) { e.preventDefault(); dialog.open ? dialog.close() : open(); }
    else if (e.key === "/" && !typing && !dialog.open) { e.preventDefault(); open(); }
  });
  document.querySelectorAll("[data-cmdk-open]").forEach((b) => b.addEventListener("click", open));
</script>
