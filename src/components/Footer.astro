---
import { getEntry } from "astro:content";
import Icon from "./Icon.astro";
import SocialLinks from "./SocialLinks.astro";
import { FOOTER_NAV } from "../lib/nav";
const me = (await getEntry("profile", "me"))!.data;
const year = new Date().getFullYear();
const updated = new Date(`${me.updated}T12:00:00Z`).toLocaleDateString("en-US", { month: "long", day: "numeric", year: "numeric", timeZone: "UTC" });
const path = Astro.url.pathname;
const showCta = !["/contact/", "/feedback/", "/audit/"].some((p) => path.startsWith(p));
---
<footer data-site-footer class:list={["mt-20", !showCta && "border-t border-border"]}>
  {showCta && (
    <section aria-labelledby="cta-h" class="border-y border-border bg-surface-2">
      <div class="container-page flex flex-col gap-6 py-12 md:flex-row md:items-center md:justify-between">
        <div>
          <h2 id="cta-h" class="font-display text-[1.75rem] font-semibold leading-tight sm:text-[2rem]">Let's talk</h2>
          <p class="mt-2 max-w-[52ch] text-[1.0625rem] text-ink-2">Research collaborations, reviewing or speaking invitations, and applied-science roles. Messages come straight to my inbox.</p>
        </div>
        <div class="flex flex-wrap gap-2">
          <a href="/contact/" class="btn btn-primary"><Icon name="mail" size={16} />Send a message</a>
          <a href="/feedback/" class="btn"><Icon name="message-square-text" size={16} />Leave feedback</a>
        </div>
      </div>
    </section>
  )}
  <div class="container-page grid gap-8 py-10 md:grid-cols-[1fr_auto] md:items-start">
    <div>
      <p class="font-display text-[1.25rem] font-semibold text-ink">{me.name}</p>
      <p class="mt-1 text-sm text-muted">{me.headline.split(" · ")[0]} · {me.title}, UST · {me.role}</p>
      <p class="mt-3 text-sm"><a href={`mailto:${me.email}`} class="link-quiet">{me.email}</a><span class="text-muted"> · {me.location}</span></p>
    </div>
    <nav aria-label="Footer">
      <ul class="flex flex-wrap gap-x-5 gap-y-2 text-sm md:max-w-[26rem] md:justify-end">
        {FOOTER_NAV.map((i) => <li><a href={i.href} class="link-plain font-medium text-ink-2 hover:text-ink">{i.label}</a></li>)}
      </ul>
    </nav>
  </div>
  <div class="border-t border-border">
    <div class="container-page flex flex-col gap-3 py-5 text-xs text-muted md:flex-row md:items-center md:justify-between">
      <SocialLinks links={me.links} class="!text-xs" />
      <p>© {year} {me.name} · Updated {updated} · <a href="/privacy/" class="text-muted">Privacy</a></p>
    </div>
  </div>
</footer>
