---
import { getEntry } from "astro:content";
const me = (await getEntry("profile", "me"))!.data;
const year = new Date().getFullYear();
const updated = new Date(`${me.updated}T12:00:00Z`).toLocaleDateString("en-US", { month: "long", day: "numeric", year: "numeric", timeZone: "UTC" });

const COLUMNS: { title: string; links: { label: string; href: string; external?: boolean }[] }[] = [
  { title: "Work", links: [
    { label: "Research", href: "/research/" }, { label: "Publications", href: "/publications/" },
    { label: "Projects", href: "/projects/" },
  ] },
  { title: "Profile", links: [
    { label: "Experience", href: "/experience/" }, { label: "Service & honors", href: "/service/" },
    { label: "CV", href: "/cv/" },
  ] },
  { title: "Connect", links: [
    { label: "Contact", href: "/contact/" }, { label: "Feedback", href: "/feedback/" },
    { label: "Google Scholar", href: me.links.scholar!, external: true },
    { label: "LinkedIn", href: me.links.linkedin!, external: true },
    { label: "GitHub", href: me.links.github!, external: true },
  ] },
];
---
<footer data-site-footer class="mt-24 border-t border-border">
  <div class="container-page grid gap-10 py-12 md:grid-cols-[minmax(0,1.6fr)_repeat(3,minmax(0,1fr))]">
    <div>
      <p class="text-[1.0625rem] font-semibold text-ink">{me.name}</p>
      <p class="mt-2 max-w-[34ch] text-sm leading-relaxed text-muted">{me.title}, UST. {me.role}.</p>
      <p class="mt-4 text-sm"><a href={`mailto:${me.email}`} class="link-quiet">{me.email}</a></p>
      <p class="mt-1 text-sm text-muted">{me.location}</p>
    </div>
    {COLUMNS.map((c) => (
      <nav aria-label={c.title}>
        <p class="text-sm font-semibold text-ink">{c.title}</p>
        <ul class="mt-3 grid gap-2 text-sm">
          {c.links.map((l) => (
            <li>
              <a href={l.href} class="link-plain text-muted hover:text-ink"
                 {...(l.external ? { target: "_blank", rel: "noopener me" } : {})}>{l.label}</a>
            </li>
          ))}
        </ul>
      </nav>
    ))}
  </div>
  <div class="border-t border-border">
    <div class="container-page flex flex-col gap-2 py-5 text-xs text-muted sm:flex-row sm:items-center sm:justify-between">
      <p>© {year} {me.name}. All rights reserved.</p>
      <p class="flex gap-4"><span>Updated {updated}</span><a href="/privacy/" class="link-plain text-muted hover:text-ink">Privacy</a></p>
    </div>
  </div>
</footer>
