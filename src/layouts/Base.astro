---
import "../styles/global.css";
import { getEntry } from "astro:content";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

interface Props {
  title?: string;
  description?: string;
  /** Extra JSON-LD objects for this page (e.g. ScholarlyArticle list). */
  jsonLd?: object[];
  noindex?: boolean;
}

const me = (await getEntry("profile", "me"))!.data;
const { title, description = me.summary, jsonLd = [], noindex = false } = Astro.props;
const fullTitle = title ? `${title} · ${me.name}` : `${me.name} · ${me.headline}`;
const canonical = new URL(Astro.url.pathname, Astro.site).toString();
const ogImage = new URL("/img/Shareef.png", Astro.site).toString();
const GA_ID = "G-48PBMT2KNK";

const person = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: me.name,
  url: Astro.site?.toString(),
  jobTitle: me.role,
  email: `mailto:${me.email}`,
  image: ogImage,
  worksFor: { "@type": "Organization", name: "UST Global Inc." },
  alumniOf: [
    { "@type": "CollegeOrUniversity", name: "Georgia State University" },
    { "@type": "CollegeOrUniversity", name: "Vignan's Foundation for Science, Technology & Research" },
  ],
  sameAs: Object.values(me.links).filter(Boolean),
};
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>
      // Apply saved or OS theme before first paint (no flash).
      (function () {
        try {
          var t = localStorage.getItem("theme");
          if (!t && window.matchMedia("(prefers-color-scheme: dark)").matches) t = "dark";
          if (t === "dark") document.documentElement.dataset.theme = "dark";
        } catch (e) {}
      })();
    </script>
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="theme-color" content="#fbfaf7" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#121315" media="(prefers-color-scheme: dark)" />
    <link rel="icon" href="/img/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" sizes="32x32" href="/img/favicon-32x32.png" />
    <link rel="apple-touch-icon" href="/img/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={me.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary" />

    <script type="application/ld+json" set:html={JSON.stringify([person, ...jsonLd])} />

    <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${GA_ID}`}></script>
    <script is:inline define:vars={{ GA_ID }}>
      window.dataLayer = window.dataLayer || [];
      function gtag() { dataLayer.push(arguments); }
      gtag("js", new Date());
      gtag("config", GA_ID);
    </script>
  </head>
  <body class="flex min-h-dvh flex-col">
    <a class="skip-link" href="#main">Skip to content</a>
    <Header />
    <main id="main" class="flex-1" tabindex="-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>
