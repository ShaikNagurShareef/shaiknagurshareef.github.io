---
import Base from "../layouts/Base.astro";
---
<Base title="Page not found" noindex>
  <section class="container-page py-24 text-center">
    <p class="eyebrow">404</p>
    <h1 class="mt-3 text-4xl font-semibold">This page doesn't exist</h1>
    <p class="mx-auto mt-4 max-w-md text-ink-2">The site was reorganized into separate pages. Try the home page or one of the sections below.</p>
    <div class="mt-8 flex flex-wrap justify-center gap-3">
      <a class="btn btn-primary" href="/">Home</a>
      <a class="btn" href="/research/">Research</a>
      <a class="btn" href="/publications/">Publications</a>
    </div>
  </section>
</Base>
