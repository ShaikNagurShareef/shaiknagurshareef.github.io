---
import Base from "../../layouts/Base.astro";
import PageHeader from "../../components/PageHeader.astro";
import SocialLinks from "../../components/SocialLinks.astro";
import Icon from "../../components/Icon.astro";
import { getEntry } from "astro:content";

const me = (await getEntry("profile", "me"))!.data;
const docs = [
  { label: "Research CV", href: me.documents.research_resume },
  { label: "Industry resume", href: me.documents.resume },
  { label: "Research statement", href: me.documents.research_statement },
  { label: "M.S. thesis", href: me.documents.ms_thesis },
];
const profiles: Array<[string, string]> = [
  ["Google Scholar", "scholar"], ["ORCID", "orcid"], ["OpenReview", "openreview"], ["GitHub", "github"],
  ["Hugging Face", "huggingface"], ["LinkedIn", "linkedin"], ["ResearchGate", "researchgate"],
  ["Web of Science", "webofscience"], ["Kaggle", "kaggle"], ["Medium", "medium"],
];
---
<Base title="Contact" description={`Get in touch with ${me.name} about research collaboration, reviewing, speaking or roles in applied AI.`}>
  <PageHeader eyebrow="Contact" title="Get in touch"
    lead="I'm glad to hear about research collaborations, reviewing and speaking invitations, and applied-science roles in multimodal and medical AI. Email is the fastest way to reach me." />

  <div class="container-page grid gap-6 py-12 lg:grid-cols-[1.3fr_1fr]">
    <section aria-labelledby="direct-h" class="card p-6 md:p-8">
      <h2 id="direct-h" class="text-2xl font-semibold">Direct</h2>
      <dl class="mt-5 grid gap-5">
        <div class="flex items-start gap-3">
          <span class="mt-0.5 text-accent-ink"><Icon name="mail" size={20} /></span>
          <div>
            <dt class="text-sm text-muted">Email</dt>
            <dd class="flex flex-wrap items-center gap-3">
              <a href={`mailto:${me.email}`} class="text-lg font-semibold">{me.email}</a>
              <button type="button" class="btn min-h-0 px-2.5 py-1 text-sm" data-copy={me.email}>
                <Icon name="copy" size={14} /><span data-copy-label>Copy</span>
              </button>
            </dd>
          </div>
        </div>
        <div class="flex items-start gap-3">
          <span class="mt-0.5 text-accent-ink"><Icon name="phone" size={20} /></span>
          <div>
            <dt class="text-sm text-muted">Phone</dt>
            <dd><a href={`tel:${me.phone.replace(/[^\d+]/g, "")}`} class="font-semibold">{me.phone}</a></dd>
          </div>
        </div>
        <div class="flex items-start gap-3">
          <span class="mt-0.5 text-accent-ink"><Icon name="map-pin" size={20} /></span>
          <div>
            <dt class="text-sm text-muted">Based in</dt>
            <dd class="font-semibold text-ink">{me.location}</dd>
          </div>
        </div>
      </dl>
      <div class="mt-8">
        <h3 class="font-sans text-sm font-semibold text-muted">Documents</h3>
        <ul class="mt-3 flex flex-wrap gap-2">
          {docs.map((d) => (
            <li><a href={d.href} target="_blank" rel="noopener" class="btn"><Icon name="file-text" size={16} />{d.label}</a></li>
          ))}
        </ul>
      </div>
    </section>

    <section aria-labelledby="profiles-h" class="card p-6 md:p-8">
      <h2 id="profiles-h" class="text-2xl font-semibold">Profiles</h2>
      <ul class="mt-5 grid gap-1">
        {profiles.filter(([, k]) => me.links[k]).map(([label, k]) => (
          <li>
            <a href={me.links[k]!} target="_blank" rel="noopener me"
               class="flex items-center justify-between rounded-md px-2 py-2 font-medium text-ink no-underline hover:bg-surface-2">
              {label}<Icon name="arrow-up-right" size={16} class="text-muted" />
            </a>
          </li>
        ))}
      </ul>
      <div class="mt-6 border-t border-border pt-5"><SocialLinks links={me.links} size="sm" /></div>
    </section>
  </div>
</Base>
