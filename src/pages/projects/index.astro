---
import Base from "../../layouts/Base.astro";
import PageHeader from "../../components/PageHeader.astro";
import ProjectCard from "../../components/ProjectCard.astro";
import Icon from "../../components/Icon.astro";
import { getCollection, getEntry } from "astro:content";

const me = (await getEntry("profile", "me"))!.data;
const projects = (await getCollection("projects")).sort(
  (a, b) => Number(b.data.featured) - Number(a.data.featured) || b.data.date.localeCompare(a.data.date),
);
const TAG_LABEL: Record<string, string> = {
  agents: "Agents", "medical-ai": "Medical AI", rag: "RAG", llm: "LLMs", ml: "ML", vision: "Vision",
  data: "Data", geospatial: "Geospatial", accessibility: "Accessibility", tooling: "Tooling",
  healthcare: "Healthcare", web: "Web",
};
const counts = new Map<string, number>();
for (const p of projects) for (const t of p.data.tags) counts.set(t, (counts.get(t) ?? 0) + 1);
const tags = [...counts].sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0]));
---
<Base title="Projects" description="Agentic systems, medical AI tools and data products, from hackathon builds to production prototypes.">
  <PageHeader title="Projects"
    lead="Agentic systems, medical AI tools and data products, from hackathon builds to production prototypes. Most are open source.">
    <a href={me.links.github!} target="_blank" rel="noopener" class="btn"><Icon brand="github" size={15} />GitHub</a>
    <a href={me.links.huggingface!} target="_blank" rel="noopener" class="btn"><Icon brand="huggingface" size={15} />Hugging Face</a>
  </PageHeader>

  <div class="border-t border-border">
    <div class="container-page pb-6 pt-8 lg:pt-10">
      <div data-tag-filter hidden role="group" aria-label="Filter projects by topic" class="tabs">
        <button type="button" data-tag="" aria-pressed="true">All <span>{projects.length}</span></button>
        {tags.map(([t, n]) => (
          <button type="button" data-tag={t} aria-pressed="false">{TAG_LABEL[t] ?? t} <span>{n}</span></button>
        ))}
      </div>
      <p class="sr-only" aria-live="polite" data-project-count></p>

      <div class="mt-8 grid gap-4 md:grid-cols-2 lg:grid-cols-3">
        {projects.map((p) => <ProjectCard project={p} />)}
      </div>
    </div>
  </div>
</Base>

<style>
  .tabs { display: flex; gap: 0.25rem 1.25rem; flex-wrap: wrap; border-bottom: 1px solid var(--border); }
  .tabs button {
    position: relative; display: inline-flex; align-items: center; gap: 0.35rem;
    height: 2.5rem; font-size: 0.875rem; font-weight: 500; color: var(--ink-2);
  }
  .tabs button span { font-size: 0.75rem; color: var(--muted); font-variant-numeric: tabular-nums; }
  .tabs button:hover { color: var(--ink); }
  .tabs button[aria-pressed="true"] { color: var(--ink); }
  .tabs button[aria-pressed="true"]::after {
    content: ""; position: absolute; left: 0; right: 0; bottom: -1px; height: 2px; background: var(--accent);
  }
</style>

<script>
  const bar = document.querySelector<HTMLElement>("[data-tag-filter]");
  const cards = [...document.querySelectorAll<HTMLElement>("[data-project]")];
  const live = document.querySelector<HTMLElement>("[data-project-count]");
  if (bar) {
    bar.hidden = false;
    const buttons = [...bar.querySelectorAll<HTMLButtonElement>("button[data-tag]")];
    const select = (tag: string) => {
      buttons.forEach((b) => b.setAttribute("aria-pressed", String(b.dataset.tag === tag)));
      let n = 0;
      for (const c of cards) {
        const ok = !tag || c.dataset.tags!.split(" ").includes(tag);
        c.hidden = !ok;
        if (ok) n++;
      }
      if (live) live.textContent = `${n} project${n === 1 ? "" : "s"} shown`;
      const url = new URL(location.href);
      tag ? url.searchParams.set("tag", tag) : url.searchParams.delete("tag");
      history.replaceState(null, "", url);
    };
    bar.addEventListener("click", (e) => {
      const b = (e.target as HTMLElement).closest<HTMLButtonElement>("button[data-tag]");
      if (b) select(b.dataset.tag!);
    });
    const initial = new URLSearchParams(location.search).get("tag") ?? "";
    if (initial && buttons.some((b) => b.dataset.tag === initial)) select(initial);
  }
</script>
