---
import Base from "../../layouts/Base.astro";
import PageHeader from "../../components/PageHeader.astro";
import Icon from "../../components/Icon.astro";
import { getCollection, getEntry } from "astro:content";
import { byOrder } from "../../lib/format";

const service = (await getEntry("service", "service"))!.data;
const awards = (await getCollection("awards")).sort((a, b) => (b.data.year ?? 0) - (a.data.year ?? 0) || byOrder(a, b));
const certs = (await getCollection("certifications")).sort(byOrder);
const events = (await getCollection("participations")).sort((a, b) => b.data.date.localeCompare(a.data.date));
const total = [...service.conferences, ...service.journals].reduce((n, v) => n + v.count, 0);
const CATEGORY: Record<string, string> = { research: "Research", industry: "Industry", academic: "Academic" };
---
<Base title="Service & honors" description={service.summary}>
  <PageHeader eyebrow="Service & honors" title="Reviewing, awards and community" lead={service.summary} />

  <section aria-labelledby="review-h" class="container-page py-12">
    <div class="flex flex-wrap items-end justify-between gap-4">
      <div>
        <p class="eyebrow">Peer review</p>
        <h2 id="review-h" class="mt-2 text-3xl font-semibold">Reviewing</h2>
      </div>
      <p class="text-sm text-muted">{total} reviews with recorded counts across {service.conferences.length + service.journals.length} venues</p>
    </div>

    <div class="mt-6 grid gap-6 lg:grid-cols-[1fr_1.6fr]">
      <div>
        <h3 class="font-sans text-base font-semibold text-ink-2">Conferences</h3>
        <ul class="mt-3 grid gap-2">
          {service.conferences.map((v) => (
            <li class="card flex items-center justify-between gap-3 px-4 py-3">
              <span class="font-semibold text-ink">{v.name}</span>
              <span class="flex items-center gap-3 text-sm">
                <span class="text-muted">{v.count} paper{v.count === 1 ? "" : "s"}</span>
                {v.url && <a href={v.url} target="_blank" rel="noopener" class="inline-flex items-center gap-1 font-semibold no-underline hover:underline">Record<Icon name="arrow-up-right" size={13} /><span class="sr-only"> for {v.name}</span></a>}
              </span>
            </li>
          ))}
        </ul>
      </div>
      <div>
        <h3 class="font-sans text-base font-semibold text-ink-2">Journals</h3>
        <ul class="card mt-3 divide-y divide-border">
          {service.journals.map((v) => (
            <li class="flex items-center justify-between gap-3 px-4 py-2.5 text-[0.9375rem]">
              <span class="text-ink">{v.name}</span>
              <span class="flex shrink-0 items-center gap-3 text-sm">
                <span class="text-muted">{v.count}</span>
                {v.url ? <a href={v.url} target="_blank" rel="noopener" class="inline-flex items-center no-underline" aria-label={`Review record for ${v.name}`}><Icon name="file-text" size={15} /></a> : <span class="w-[15px]" aria-hidden="true"></span>}
              </span>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <section aria-labelledby="awards-h" class="container-page py-8">
    <p class="eyebrow">Recognition</p>
    <h2 id="awards-h" class="mt-2 text-3xl font-semibold">Honors and awards</h2>
    <ul class="mt-6 grid gap-3 md:grid-cols-2">
      {awards.map((a) => (
        <li class="card flex gap-4 p-4">
          <span class="inline-flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-accent-soft text-accent-ink" aria-hidden="true">
            <Icon name={a.data.category === "research" ? "award" : a.data.category === "industry" ? "trophy" : "graduation-cap"} />
          </span>
          <div>
            <p class="font-semibold text-ink">{a.data.title}</p>
            <p class="text-sm text-muted">{a.data.org}{a.data.year ? ` · ${a.data.year}` : ""} · {CATEGORY[a.data.category]}</p>
            {a.data.detail && <p class="mt-1 text-sm text-ink-2">{a.data.detail}</p>}
          </div>
        </li>
      ))}
    </ul>
  </section>

  <section aria-labelledby="events-h" class="container-page py-12">
    <p class="eyebrow">Community</p>
    <h2 id="events-h" class="mt-2 text-3xl font-semibold">Events and hackathons</h2>
    <ul class="mt-6 grid gap-3 md:grid-cols-2">
      {events.map((e) => (
        <li class="card p-4">
          <p class="text-sm font-semibold text-muted">{e.data.dateLabel} · {e.data.location}</p>
          <p class="mt-1 font-semibold">
            <a href={e.data.url} target="_blank" rel="noopener" class="text-ink no-underline hover:text-accent-ink hover:underline">{e.data.title}</a>
          </p>
          <p class="text-sm text-muted">{e.data.host}</p>
          <p class="mt-2 text-sm text-ink-2">{e.data.detail}</p>
        </li>
      ))}
    </ul>
  </section>

  <section aria-labelledby="certs-h" class="container-page py-8">
    <p class="eyebrow">Credentials</p>
    <h2 id="certs-h" class="mt-2 text-3xl font-semibold">Certifications</h2>
    <ul class="card mt-6 divide-y divide-border">
      {certs.map((c) => (
        <li class="flex items-center justify-between gap-4 px-4 py-3">
          <span>
            <span class="block font-semibold text-ink">{c.data.title}</span>
            <span class="block text-sm text-muted">{c.data.issuer}</span>
          </span>
          {c.data.url && <a href={c.data.url} target="_blank" rel="noopener" class="inline-flex shrink-0 items-center gap-1 text-sm font-semibold no-underline hover:underline">Credential<Icon name="arrow-up-right" size={13} /><span class="sr-only"> for {c.data.title}</span></a>}
        </li>
      ))}
    </ul>
  </section>
</Base>
