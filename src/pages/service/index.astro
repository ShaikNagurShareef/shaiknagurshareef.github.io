---
import Base from "../../layouts/Base.astro";
import PageHeader from "../../components/PageHeader.astro";
import Section from "../../components/Section.astro";
import Icon from "../../components/Icon.astro";
import { getCollection, getEntry } from "astro:content";
import { byOrder, yearSpan } from "../../lib/format";

const service = (await getEntry("service", "service"))!.data;
const awards = (await getCollection("awards")).sort((a, b) => (b.data.year ?? 0) - (a.data.year ?? 0) || byOrder(a, b));
const certs = (await getCollection("certifications")).sort(byOrder);
const events = (await getCollection("participations")).sort((a, b) => b.data.date.localeCompare(a.data.date));
const counted = [...service.conferences, ...service.journals].filter((v) => v.count !== null);
const total = counted.reduce((n, v) => n + (v.count ?? 0), 0);
const activeCount = service.conferences.filter((v) => v.active).length;
const CATEGORY: Record<string, string> = { research: "Research", industry: "Industry", academic: "Academic" };
---
<Base title="Service & honors" description={service.summary}>
  <PageHeader title="Service and honors" lead={service.summary}>
    <Fragment slot="meta">
      <dl class="mt-8 flex flex-wrap gap-x-10 gap-y-4 border-t border-border pt-5">
        {[
          { v: total, l: "Completed reviews" },
          { v: counted.length, l: "Venues" },
          { v: activeCount, l: "Active reviewing roles" },
          { v: awards.length, l: "Honors and awards" },
        ].map((f) => (
          <div class="flex flex-col-reverse justify-end">
            <dt class="text-xs text-muted">{f.l}</dt>
            <dd class="text-xl font-semibold tabular text-ink">{f.v}</dd>
          </div>
        ))}
      </dl>
    </Fragment>
  </PageHeader>

  <Section id="review-h" title="Peer review" description="Conference program committees and journal reviewing. Records link to the reviewer certificate or platform entry.">
    <h3 class="subhead">Conferences</h3>
    <table class="table mt-3">
      <thead><tr><th scope="col">Venue</th><th scope="col">Status</th><th scope="col" class="num">Reviews</th><th scope="col" class="num"><span class="sr-only">Record</span></th></tr></thead>
      <tbody>
        {service.conferences.map((v) => (
          <tr>
            <td class="font-medium text-ink">{v.name}</td>
            <td>{v.active ? <span class="badge badge-ok"><span class="dot"></span>Active</span> : <span class="text-muted">Completed</span>}</td>
            <td class="num text-ink-2">{v.count ?? "–"}</td>
            <td class="num">{v.url && <a href={v.url} target="_blank" rel="noopener" class="link-more !text-[0.8125rem]">Record<Icon name="arrow-up-right" size={12} /><span class="sr-only"> for {v.name}</span></a>}</td>
          </tr>
        ))}
      </tbody>
    </table>

    <h3 class="subhead mt-10">Journals</h3>
    <table class="table mt-3">
      <thead><tr><th scope="col">Journal</th><th scope="col" class="num">Reviews</th><th scope="col" class="num"><span class="sr-only">Record</span></th></tr></thead>
      <tbody>
        {service.journals.map((v) => (
          <tr>
            <td class="text-ink">{v.name}</td>
            <td class="num text-ink-2">{v.count ?? "–"}</td>
            <td class="num">{v.url && <a href={v.url} target="_blank" rel="noopener" class="link-more !text-[0.8125rem]">Record<Icon name="arrow-up-right" size={12} /><span class="sr-only"> for {v.name}</span></a>}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </Section>

  <Section id="awards-h" title="Honors and awards">
    <ol class="rows -mt-3">
      {awards.map((a) => (
        <li class="grid gap-1 py-4 sm:grid-cols-[6.5rem_1fr_auto] sm:gap-6">
          <span class="text-sm tabular text-muted">{yearSpan(a.data)}</span>
          <div>
            <p class="font-semibold text-ink">{a.data.title}</p>
            <p class="text-sm text-ink-2">{a.data.org}</p>
            {a.data.detail && <p class="mt-1 text-sm text-muted">{a.data.detail}</p>}
          </div>
          <span class="text-xs text-muted sm:pt-1 sm:text-right">{CATEGORY[a.data.category]}</span>
        </li>
      ))}
    </ol>
  </Section>

  <Section id="events-h" title="Events and hackathons">
    <ol class="rows -mt-3">
      {events.map((e) => (
        <li class="grid gap-1 py-4 sm:grid-cols-[6.5rem_1fr] sm:gap-6">
          <span class="text-sm tabular text-muted">{e.data.dateLabel.replace(/,?\s*\d{4}$/, "")}<br class="hidden sm:block" /><span class="sm:hidden"> </span>{e.data.date.slice(0, 4)}</span>
          <div>
            <p class="font-semibold"><a href={e.data.url} target="_blank" rel="noopener" class="link-plain text-ink">{e.data.title}</a></p>
            <p class="text-sm text-ink-2">{e.data.host} · {e.data.location}</p>
            <p class="mt-1 text-sm text-muted prose-measure">{e.data.detail}</p>
          </div>
        </li>
      ))}
    </ol>
  </Section>

  <Section id="certs-h" title="Certifications">
    <ul class="rows -mt-3">
      {certs.map((c) => (
        <li class="flex items-center justify-between gap-4 py-3">
          <span>
            <span class="block text-[0.9375rem] font-medium text-ink">{c.data.title}</span>
            <span class="block text-sm text-muted">{c.data.issuer}</span>
          </span>
          {c.data.url && <a href={c.data.url} target="_blank" rel="noopener" class="link-more shrink-0 !text-[0.8125rem]">Credential<Icon name="arrow-up-right" size={12} /><span class="sr-only"> for {c.data.title}</span></a>}
        </li>
      ))}
    </ul>
  </Section>
</Base>
