---
import Base from "../../layouts/Base.astro";
import PageHeader from "../../components/PageHeader.astro";
import Section from "../../components/Section.astro";
import Icon from "../../components/Icon.astro";
import { getCollection, getEntry } from "astro:content";
import { byOrder, yearSpan, ym } from "../../lib/format";

const service = (await getEntry("service", "service"))!.data;
const awards = (await getCollection("awards")).sort((a, b) => (b.data.year ?? 0) - (a.data.year ?? 0) || byOrder(a, b));
const certs = (await getCollection("certifications")).sort(byOrder);
const events = (await getCollection("participations")).sort((a, b) => b.data.date.localeCompare(a.data.date));
const counted = [...service.conferences, ...service.journals].filter((v) => v.count !== null);
const total = counted.reduce((n, v) => n + (v.count ?? 0), 0);
const activeCount = service.conferences.filter((v) => v.active).length;
const CATEGORY: Record<string, string> = { research: "Research", industry: "Industry", academic: "Academic" };
---
<Base title="Service & honors" description={service.summary}>
  <PageHeader title="Service and honors" lead={service.summary}>
    <Fragment slot="meta">
      <dl class="mt-8 flex flex-wrap gap-x-10 gap-y-4 border-t border-border pt-5">
        {[
          { v: total, l: "Completed reviews", href: "#review-h" },
          { v: counted.length, l: "Venues", href: "#review-h" },
          { v: activeCount, l: "Active reviewing roles", href: "#review-h" },
          ...(service.invitations ? [{ v: service.invitations.total, l: `Review invitations since ${service.invitations.since}`, href: "/service/review-log/" }] : []),
          { v: awards.length, l: "Honors and awards", href: "#awards-h" },
        ].map((f) => (
          <div class="figure-link relative flex flex-col-reverse justify-end">
            <dt class="flex items-center gap-1 text-xs text-muted">{f.l}<Icon name="arrow-right" size={11} class="figure-arrow" /></dt>
            <dd class="font-display text-[1.75rem] font-semibold tabular text-ink"><a href={f.href} class="figure-a">{f.v}<span class="sr-only"> {f.l}</span></a></dd>
          </div>
        ))}
      </dl>
    </Fragment>
  </PageHeader>

  <Section id="review-h" title="Peer review">
    <a href="/service/review-log/" class="cert-link mb-6"><Icon name="list" size={14} />Full peer-review log ({service.invitations?.total ?? ""} invitations)</a>
    <h3 class="subhead">Conferences</h3>
    <table class="table mt-3">
      <thead><tr><th scope="col">Venue</th><th scope="col">Status</th><th scope="col" class="num">Reviews</th><th scope="col" class="num"><span class="sr-only">Record</span></th></tr></thead>
      <tbody>
        {service.conferences.map((v) => (
          <tr>
            <td class="font-medium text-ink">{v.name}</td>
            <td>{v.active ? <span class="badge badge-ok"><span class="dot"></span>Active</span> : <span class="text-muted">Completed</span>}</td>
            <td class="num text-ink-2">{v.count ?? "–"}</td>
            <td class="num">{v.url && <a href={v.url} target="_blank" rel="noopener" class="link-more !text-[0.875rem]">Record<span class="sr-only"> for {v.name}</span></a>}</td>
          </tr>
        ))}
      </tbody>
    </table>

    <h3 class="subhead mt-10">Journals</h3>
    <table class="table mt-3">
      <thead><tr><th scope="col">Journal</th><th scope="col" class="num">Reviews</th><th scope="col" class="num"><span class="sr-only">Record</span></th></tr></thead>
      <tbody>
        {service.journals.map((v) => (
          <tr>
            <td class="text-ink">{v.name}</td>
            <td class="num text-ink-2">{v.count ?? "–"}</td>
            <td class="num">{v.url && <a href={v.url} target="_blank" rel="noopener" class="link-more !text-[0.875rem]">Record<span class="sr-only"> for {v.name}</span></a>}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </Section>

  <Section id="awards-h" title="Honors and awards">
    <ol class="rows -mt-3">
      {awards.map((a) => (
        <li class="grid gap-1 py-4 sm:grid-cols-[6.5rem_1fr_auto] sm:gap-6">
          <span class="mono pt-0.5 text-muted">{yearSpan(a.data)}</span>
          <div class="flex gap-3">
            <span class="award-icon" aria-hidden="true"><Icon name={a.data.category === "research" ? "award" : a.data.category === "industry" ? "trophy" : "graduation-cap"} size={16} /></span>
            <div>
            <p class="font-semibold text-ink">{a.data.title}</p>
            <p class="text-sm text-ink-2">{a.data.org}</p>
            {a.data.detail && <p class="mt-1 text-sm text-muted">{a.data.detail}</p>}
            {a.data.url && <a href={a.data.url} class="cert-link mt-2" {...(a.data.url.startsWith("/data/") ? { target: "_blank", rel: "noopener" } : {})}><Icon name="badge-check" size={14} />Evidence<span class="sr-only"> for {a.data.title}</span></a>}
            </div>
          </div>
          <span class="text-xs text-muted sm:pt-1 sm:text-right">{CATEGORY[a.data.category]}</span>
        </li>
      ))}
    </ol>
  </Section>

  <Section id="events-h" title="Events and hackathons">
    <ol class="rows -mt-3">
      {events.map((e) => (
        <li class="grid gap-1 py-4 sm:grid-cols-[6.5rem_1fr] sm:gap-6">
          <span class="text-sm tabular text-muted">{e.data.dateLabel.replace(/,?\s*\d{4}$/, "")}<br class="hidden sm:block" /><span class="sm:hidden"> </span>{e.data.date.slice(0, 4)}</span>
          <div>
            <p class="font-semibold"><a href={e.data.url} target="_blank" rel="noopener" class="link-plain text-ink">{e.data.title}</a></p>
            <p class="text-sm text-ink-2">{e.data.host} · {e.data.location}</p>
            <p class="mt-1 text-sm text-muted prose-measure">{e.data.detail}</p>
          </div>
        </li>
      ))}
    </ol>
  </Section>

  <Section id="certs-h" title="Certifications">
    <ul class="rows -mt-3">
      {certs.map((c) => (
        <li class="flex flex-col gap-2 py-3.5 sm:flex-row sm:items-center sm:justify-between sm:gap-4">
          <span class="min-w-0">
            <span class="block text-[1.0625rem] font-medium text-ink">{c.data.title}</span>
            <span class="block text-sm text-muted">{c.data.issuer}{c.data.date && <span class="mono"> · {ym(c.data.date)}</span>}{c.data.note && <span> · {c.data.note}</span>}</span>
          </span>
          <span class="flex shrink-0 gap-2">
            {c.data.url && <a href={c.data.url} target="_blank" rel="noopener" class="cert-link"><Icon name="file-text" size={14} />Certificate<span class="sr-only"> for {c.data.title}</span></a>}
            {c.data.verify && <a href={c.data.verify} target="_blank" rel="noopener" class="cert-link"><Icon name="badge-check" size={14} />Verify<span class="sr-only"> {c.data.title} with the issuer</span></a>}
          </span>
        </li>
      ))}
    </ul>
  </Section>
</Base>

<style>
  .award-icon {
    display: inline-flex; flex-shrink: 0; align-items: center; justify-content: center; width: 2rem; height: 2rem; margin-top: 0.1rem;
    border-radius: 999px; background: var(--surface-2); color: var(--ink); border: 1px solid var(--border);
  }
  li:hover > div > .award-icon { background: var(--ink); color: var(--bg); border-color: var(--ink); }
  .award-icon { transition: background-color 200ms, color 200ms, border-color 200ms; }
  .cert-link {
    display: inline-flex; align-items: center; gap: 0.35rem; height: 2rem; padding-inline: 0.7rem;
    border: 1px solid var(--border); border-radius: 999px; font-size: 0.8125rem; font-weight: 600;
    color: var(--ink); text-decoration: none; transition: border-color 150ms, background-color 150ms;
  }
  .cert-link:hover { border-color: var(--ink); background: var(--surface-2); }
</style>
