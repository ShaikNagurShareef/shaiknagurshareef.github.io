---
import Base from "../layouts/Base.astro";
import Icon from "../components/Icon.astro";
import SocialLinks from "../components/SocialLinks.astro";
import Pathway from "../components/Pathway.astro";
import PubItem from "../components/PubItem.astro";
import Section from "../components/Section.astro";
import ProjectCard from "../components/ProjectCard.astro";
import { getCollection, getEntry } from "astro:content";
import { byRecency, ym } from "../lib/format";

const me = (await getEntry("profile", "me"))!.data;
const research = (await getEntry("research", "research"))!.data;
const pubs = (await getCollection("publications")).sort(byRecency);
const featuredPubs = pubs.filter((p) => p.data.status === "published" && p.data.presentation === "oral").slice(0, 4);
const projects = (await getCollection("projects")).filter((p) => p.data.featured).slice(0, 3);
// Year-only dates ("2026") sort after dated months of the same year.
const sortKey = (d: string) => (d.length === 4 ? `${d}-00` : d);
const news = (await getCollection("news")).sort((a, b) => sortKey(b.data.date).localeCompare(sortKey(a.data.date))).slice(0, 5);
const underReview = pubs.filter((p) => p.data.status !== "published").length;

const stats = [
  { value: String(me.stats.papers), label: "Peer-reviewed papers" },
  { value: me.stats.citations, label: "Citations" },
  { value: String(me.stats.h_index), label: "h-index" },
  { value: String(underReview), label: "Manuscripts in review" },
];
// Headline under the name: identity · focus ("Applied Scientist · Multimodal Medical AI & Agentic Systems").
const focus = me.headline;
const roles = [
  { title: me.title, org: me.titleOrg },
  { title: me.role.split(", ")[0], org: me.role.split(", ").slice(1).join(", ") },
];
const asOf = ym(me.stats.as_of);
---
<Base>
  <script is:inline>
    // The old one-page site linked to sections by hash; send those links to the new pages.
    (function () {
      var map = {
        education: "/experience/#edu-h", experience: "/experience/", skills: "/experience/#skills-h",
        interests: "/experience/#skills-h", projects: "/projects/", research: "/research/",
        team: "/research/#committee-h", publications: "/publications/", conferences: "/publications/?kind=conference",
        journals: "/publications/?kind=journal", "under-review": "/publications/#review-h", services: "/service/",
        reviewer: "/service/#review-h", certifications: "/service/#certs-h", awards: "/service/#awards-h",
        participations: "/service/#events-h"
      };
      var t = map[location.hash.slice(1)];
      if (t) location.replace(t);
    })();
  </script>
  <!-- Hero -->
  <section class="container-page grid gap-10 pb-14 pt-12 md:grid-cols-[minmax(0,1fr)_15rem] md:gap-16 md:pb-20 md:pt-20 lg:grid-cols-[minmax(0,1fr)_17rem]">
    <div class="max-w-[46rem]">
      <h1 class="text-[2.75rem] sm:text-[4rem]">{me.name}</h1>
      <p class="mt-4 text-[1.25rem] font-medium text-ink-2 sm:text-[1.5rem]">{focus}</p>
      <dl class="mt-7 grid gap-3 border-l-2 border-accent pl-4 text-[1.0625rem]">
        {roles.map((r) => (
          <div>
            <dt class="font-semibold text-ink">{r.title}</dt>
            <dd class="text-muted">{r.org}</dd>
          </div>
        ))}
      </dl>
      <p class="mt-7 text-[1.125rem] leading-relaxed text-ink-2 prose-measure">{me.summary}</p>
      <div class="mt-8 flex flex-wrap gap-2">
        <a href="/research/" class="btn btn-primary">Research program<Icon name="arrow-right" size={15} /></a>
        <a href="/publications/" class="btn">Publications</a>
        <a href={me.documents.research_resume} class="btn" target="_blank" rel="noopener"><Icon name="download" size={15} />CV (PDF)</a>
      </div>
      <SocialLinks links={me.links} class="mt-7" />
    </div>
    <div class="hidden md:block">
      <img src="/img/Shareef-hero.webp" alt={`Portrait of ${me.name}`} width="560" height="700"
           class="aspect-[4/5] w-full rounded-[var(--radius-lg)] bg-surface-2 object-cover" loading="eager" fetchpriority="high" />
      <p class="mt-3 text-xs text-muted">{me.location} · <a href="/contact/" class="text-muted">Contact</a></p>
    </div>
  </section>

  <!-- Key figures -->
  <section aria-labelledby="stats-h" class="border-y border-border bg-surface-2">
    <div class="container-page py-8">
      <h2 id="stats-h" class="sr-only">At a glance</h2>
      <dl class="grid grid-cols-2 gap-y-6 md:grid-cols-4">
        {stats.map((s, i) => (
          <div class:list={["flex flex-col-reverse justify-end gap-1 pr-4", i % 2 === 1 && "border-l border-border pl-5 md:pl-6", i >= 2 && "md:border-l md:border-border md:pl-6"]}>
            <dt class="text-sm text-muted">{s.label}</dt>
            <dd class="font-display text-[2.5rem] font-semibold leading-none text-ink tabular">{s.value}</dd>
          </div>
        ))}
      </dl>
      <p class="mt-5 text-xs text-muted">Citation metrics: {me.stats.source}, {asOf}. Paper count includes workshops.</p>
    </div>
  </section>

  <Section id="pathway-h" title="Research program" description={`Ph.D. dissertation, Georgia State University. ${research.dissertation.status}.`}>
    <a slot="head" href="/research/" class="link-more mt-4 hidden lg:inline-flex">About the dissertation<Icon name="arrow-right" size={14} /></a>
    <p class="max-w-[62ch] text-[1.0625rem] leading-relaxed text-ink-2">{research.dissertation.summary}</p>
    <div class="mt-8"><Pathway stages={research.dissertation.stages} /></div>
    <a href="/research/" class="link-more mt-6 lg:hidden">About the dissertation<Icon name="arrow-right" size={14} /></a>
  </Section>

  <Section id="pubs-h" title="Selected publications" description="Recent papers presented orally at peer-reviewed venues.">
    <a slot="head" href="/publications/" class="link-more mt-4 hidden lg:inline-flex">All {me.stats.papers} publications<Icon name="arrow-right" size={14} /></a>
    <div class="rows -mt-5">
      {featuredPubs.map((p) => <PubItem pub={p} />)}
    </div>
    <a href="/publications/" class="link-more mt-4 lg:hidden">All publications<Icon name="arrow-right" size={14} /></a>
  </Section>

  <Section id="proj-h" title="Selected projects" description="Systems built outside the dissertation, most of them open source." stacked>
    <a slot="head" href="/projects/" class="link-more hidden lg:inline-flex">All projects<Icon name="arrow-right" size={14} /></a>
    <div class="grid gap-4 md:grid-cols-2 lg:grid-cols-3">
      {projects.map((p) => <ProjectCard project={p} />)}
    </div>
    <a href="/projects/" class="link-more mt-6 lg:hidden">All projects<Icon name="arrow-right" size={14} /></a>
  </Section>

  <Section id="news-h" title="News">
    <ol class="rows -mt-3">
      {news.map((n) => (
        <li class="grid gap-1 py-3 sm:grid-cols-[7rem_1fr] sm:gap-6">
          <span class="text-sm tabular text-muted">{ym(n.data.date)}</span>
          <span class="text-[1.0625rem] text-ink-2">{n.data.text}</span>
        </li>
      ))}
    </ol>
  </Section>
</Base>
