---
import Base from "../layouts/Base.astro";
import Icon from "../components/Icon.astro";
import SocialLinks from "../components/SocialLinks.astro";
import Pathway from "../components/Pathway.astro";
import PubItem from "../components/PubItem.astro";
import Section from "../components/Section.astro";
import ProjectCard from "../components/ProjectCard.astro";
import { getCollection, getEntry } from "astro:content";
import { byRecency, ym } from "../lib/format";

const me = (await getEntry("profile", "me"))!.data;
const research = (await getEntry("research", "research"))!.data;
const pubs = (await getCollection("publications")).sort(byRecency);
const featuredPubs = pubs.filter((p) => p.data.status === "published" && p.data.presentation === "oral").slice(0, 4);
const projects = (await getCollection("projects")).filter((p) => p.data.featured).slice(0, 3);
// Year-only dates ("2026") sort after dated months of the same year.
const sortKey = (d: string) => (d.length === 4 ? `${d}-00` : d);
const news = (await getCollection("news")).sort((a, b) => sortKey(b.data.date).localeCompare(sortKey(a.data.date))).slice(0, 5);
const underReview = pubs.filter((p) => p.data.status !== "published").length;

const stats = [
  { value: String(me.stats.papers), label: "Peer-reviewed papers", icon: "file-text", href: "/publications/" },
  { value: me.stats.citations, label: "Citations", icon: "quote", href: me.links.scholar!, external: true },
  { value: String(me.stats.h_index), label: "h-index", icon: "trending-up", href: me.links.scholar!, external: true },
  { value: String(underReview), label: "Manuscripts in review", icon: "hourglass", href: "/publications/#review-h" },
];
// Headline under the name: identity · focus ("Applied Scientist · Multimodal Medical AI & Agentic Systems").
const focus = me.headline;
const roles = [
  { title: me.title, org: me.titleOrg },
  { title: me.role.split(", ")[0], org: me.role.split(", ").slice(1).join(", ") },
];
const asOf = ym(me.stats.as_of);
// Short venue names for the "Published at" strip, from the publication records (published only).
const VENUE_SHORT: [RegExp, string][] = [
  [/\(AAAI/, "AAAI"], [/NeurIPS/, "NeurIPS (GenAI4Health)"], [/ICASSP/, "IEEE ICASSP"], [/\(ICIP\)/, "IEEE ICIP"],
  [/\(ISBI\)/, "IEEE ISBI"], [/\(EMBC/, "IEEE EMBC"], [/MLSP/, "IEEE MLSP"],
  [/Machine Vision and Applications/, "Machine Vision and Applications"], [/Image and Vision Computing/, "Image and Vision Computing"],
  [/Computers in Biology and Medicine/, "Computers in Biology and Medicine"], [/Applied Intelligence/, "Applied Intelligence"],
  [/Signal Image and Video Processing/, "Signal, Image and Video Processing"], [/IJPRAI/, "IJPRAI"],
  [/Ambient Intelligence/, "J. Ambient Intelligence & Humanized Computing"], [/Electronics/, "Electronics (MDPI)"],
];
const venues = [...new Set(pubs.filter((p) => p.data.status === "published")
  .map((p) => VENUE_SHORT.find(([re]) => re.test(p.data.venue))?.[1]).filter((v): v is string => Boolean(v)))];
---
<Base>
  <script is:inline>
    // The old one-page site linked to sections by hash; send those links to the new pages.
    (function () {
      var map = {
        education: "/experience/#edu-h", experience: "/experience/", skills: "/experience/#skills-h",
        interests: "/experience/#skills-h", projects: "/projects/", research: "/research/",
        team: "/research/#committee-h", publications: "/publications/", conferences: "/publications/?kind=conference",
        journals: "/publications/?kind=journal", "under-review": "/publications/#review-h", services: "/service/",
        reviewer: "/service/#review-h", certifications: "/service/#certs-h", awards: "/service/#awards-h",
        participations: "/service/#events-h"
      };
      var t = map[location.hash.slice(1)];
      if (t) location.replace(t);
    })();
  </script>
  <!-- Hero -->
  <div class="hero-wrap">
  <section class="container-page relative grid gap-10 pb-14 pt-12 md:grid-cols-[minmax(0,1fr)_15rem] md:gap-16 md:pb-20 md:pt-20 lg:grid-cols-[minmax(0,1fr)_17rem]">
    <div class="hero-in max-w-[46rem]">
      <h1 class="text-[2.75rem] sm:text-[3.75rem]">{me.name}{me.credentials && <span class="font-normal text-ink-2">, {me.credentials}</span>}</h1>
      <p class="mt-4 text-[1.25rem] font-medium text-ink-2 sm:text-[1.5rem]">{focus}</p>
      <dl class="mt-8 grid gap-4 border-y border-border py-5 text-[1rem] sm:grid-cols-2 sm:gap-8">
        {roles.map((r) => (
          <div>
            <dt class="font-semibold text-ink">{r.title}</dt>
            <dd class="text-muted">{r.org}</dd>
          </div>
        ))}
      </dl>
      <p class="mt-7 text-[1.125rem] leading-relaxed text-ink-2 prose-measure">{me.summary}</p>
      <div class="mt-8 flex flex-wrap gap-2">
        <a href="/research/" class="btn btn-primary">Research program<Icon name="arrow-right" size={15} /></a>
        <a href="/publications/" class="btn">Publications</a>
        <a href={me.documents.research_resume} class="btn" target="_blank" rel="noopener"><Icon name="download" size={15} />CV (PDF)</a>
      </div>
      <SocialLinks links={me.links} class="mt-7" />
    </div>
    <div class="fade-in hidden md:block">
      <div class="portrait-stage" data-tilt>
        <div class="portrait">
          <img src="/img/Shareef-2026-hero.webp" alt={`Portrait of ${me.name}`} width="560" height="700"
               class="aspect-[4/5] w-full object-cover" loading="eager" fetchpriority="high" />
        </div>
      </div>
    </div>
  </section>
  </div>

  <!-- Key figures -->
  <section aria-labelledby="stats-h" class="border-y border-border bg-surface-2" data-reveal>
    <div class="container-page py-8">
      <h2 id="stats-h" class="sr-only">At a glance</h2>
      <dl class="grid grid-cols-2 gap-y-6 md:grid-cols-4">
        {stats.map((s, i) => (
          <div class:list={["figure-link flex flex-col-reverse justify-end gap-1 pr-4", i % 2 === 1 && "border-l border-border pl-5 md:pl-6", i >= 2 && "md:border-l md:border-border md:pl-6"]}>
            <dt class="flex items-center gap-1.5 text-sm text-muted"><Icon name={s.icon} size={14} />{s.label}<Icon name={s.external ? "arrow-up-right" : "arrow-right"} size={12} class="figure-arrow" /></dt>
            <dd class="font-display text-[2.5rem] font-semibold leading-none text-ink tabular"><a href={s.href} class="figure-a" {...(s.external ? { target: "_blank", rel: "noopener" } : {})}><span data-count={s.value}>{s.value}</span><span class="sr-only"> {s.label}{s.external ? " (Google Scholar)" : ""}</span></a></dd>
          </div>
        ))}
      </dl>
      <p class="mt-5 text-xs text-muted">Citation metrics: {me.stats.source}, {asOf}. Paper count includes workshops.</p>
    </div>
  </section>

  <!-- Venues (scrolling strip; static and wrapped when motion is reduced) -->
  <section aria-labelledby="venues-h" class="venues border-b border-border">
    <div class="container-page flex items-center gap-6 py-5">
      <h2 id="venues-h" class="subhead shrink-0">Published at</h2>
      <div class="marquee" data-marquee>
        <ul class="marquee-track">
          {[...venues, ...venues].map((v, i) => <li aria-hidden={i >= venues.length ? "true" : undefined}>{v}</li>)}
        </ul>
      </div>
    </div>
  </section>

  <Section id="pathway-h" title="Research program" description={`Ph.D. dissertation, Georgia State University. ${research.dissertation.status}.`}>
    <a slot="head" href="/research/" class="link-more mt-4 hidden lg:inline-flex">About the dissertation<Icon name="arrow-right" size={14} /></a>
    <p class="max-w-[62ch] text-[1.0625rem] leading-relaxed text-ink-2">{research.dissertation.summary}</p>
    <div class="mt-8"><Pathway stages={research.dissertation.stages} /></div>
    <a href="/research/" class="link-more mt-6 lg:hidden">About the dissertation<Icon name="arrow-right" size={14} /></a>
  </Section>

  <Section id="pubs-h" title="Selected publications" description="Recent papers presented orally at peer-reviewed venues.">
    <a slot="head" href="/publications/" class="link-more mt-4 hidden lg:inline-flex">All {me.stats.papers} publications<Icon name="arrow-right" size={14} /></a>
    <div class="rows -mt-5">
      {featuredPubs.map((p) => <PubItem pub={p} />)}
    </div>
    <a href="/publications/" class="link-more mt-4 lg:hidden">All publications<Icon name="arrow-right" size={14} /></a>
  </Section>

  <Section id="proj-h" title="Selected projects" description="Systems built outside the dissertation, most of them open source." stacked>
    <a slot="head" href="/projects/" class="link-more hidden lg:inline-flex">All projects<Icon name="arrow-right" size={14} /></a>
    <div class="grid gap-4 md:grid-cols-2 lg:grid-cols-3">
      {projects.map((p) => <ProjectCard project={p} />)}
    </div>
    <a href="/projects/" class="link-more mt-6 lg:hidden">All projects<Icon name="arrow-right" size={14} /></a>
  </Section>

  <Section id="news-h" title="News">
    <ol class="rows -mt-3">
      {news.map((n) => (
        <li class="grid gap-1 py-3 sm:grid-cols-[7rem_1fr] sm:gap-6">
          <span class="mono pt-0.5 text-muted">{ym(n.data.date)}</span>
          <span class="text-[1.0625rem] text-ink-2">{n.data.text}</span>
        </li>
      ))}
    </ol>
  </Section>
</Base>

<style>
  /* Hero: faint dot grid fading out toward the edges */
  .hero-wrap { position: relative; overflow: hidden; }
  .hero-wrap::before {
    content: ""; position: absolute; inset: 0; pointer-events: none;
    background-image: radial-gradient(color-mix(in srgb, var(--ink) 16%, transparent) 1px, transparent 1.2px);
    background-size: 22px 22px;
    mask-image: radial-gradient(ellipse 70% 80% at 78% 30%, #000 0%, transparent 70%);
    -webkit-mask-image: radial-gradient(ellipse 70% 80% at 78% 30%, #000 0%, transparent 70%);
  }
  /* Portrait: matted frame on a soft glow, gentle tilt toward the cursor */
  .portrait-stage { position: relative; transform-style: preserve-3d; transition: transform 400ms cubic-bezier(0.2, 0.7, 0.2, 1); }
  .portrait-stage::before {
    content: ""; position: absolute; inset: 6% 4% 14%; z-index: 0; border-radius: 40%;
    background: radial-gradient(closest-side, color-mix(in srgb, var(--ink) 22%, transparent), transparent);
    filter: blur(28px); opacity: 0.55;
  }
  .portrait {
    position: relative; z-index: 1; padding: 6px; border-radius: calc(var(--radius-lg) + 6px);
    background: var(--surface); border: 1px solid var(--border);
    box-shadow: 0 1px 2px rgb(0 0 0 / 0.06), 0 22px 48px -22px rgb(0 0 0 / 0.45);
  }
  .portrait img { display: block; border-radius: var(--radius-lg); }
  @media (prefers-reduced-motion: reduce) { .portrait-stage { transition: none; transform: none !important; } }

  /* Venue strip */
  .marquee { position: relative; flex: 1; overflow: hidden; mask-image: linear-gradient(90deg, transparent, #000 6%, #000 94%, transparent); -webkit-mask-image: linear-gradient(90deg, transparent, #000 6%, #000 94%, transparent); }
  .marquee-track { display: flex; width: max-content; gap: 2.5rem; animation: marquee 48s linear infinite; }
  .marquee-track li { font-size: 0.9375rem; font-weight: 600; color: var(--ink-2); white-space: nowrap; }
  .marquee-track li + li::before { content: "·"; margin-right: 2.5rem; color: var(--border-strong); }
  .marquee:hover .marquee-track { animation-play-state: paused; }
  @keyframes marquee { to { transform: translateX(-50%); } }
  @media (prefers-reduced-motion: reduce) {
    .marquee { mask-image: none; -webkit-mask-image: none; }
    .marquee-track { animation: none; width: auto; flex-wrap: wrap; gap: 0.5rem 1.25rem; }
    .marquee-track li[aria-hidden] { display: none; }
    .marquee-track { gap: 0.5rem 1.75rem; }
    .marquee-track li + li::before { content: none; }
  }
</style>

<script>
  // Gentle 3D tilt of the portrait toward the cursor (fine pointers, motion allowed).
  const stage = document.querySelector<HTMLElement>("[data-tilt]");
  if (stage && matchMedia("(hover: hover) and (pointer: fine)").matches && !matchMedia("(prefers-reduced-motion: reduce)").matches) {
    stage.addEventListener("pointermove", (e) => {
      const r = stage.getBoundingClientRect();
      const x = (e.clientX - r.left) / r.width - 0.5, y = (e.clientY - r.top) / r.height - 0.5;
      stage.style.transform = `perspective(900px) rotateY(${x * 6}deg) rotateX(${-y * 6}deg)`;
    });
    stage.addEventListener("pointerleave", () => (stage.style.transform = ""));
  }
</script>
