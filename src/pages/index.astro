---
import Base from "../layouts/Base.astro";
import Icon from "../components/Icon.astro";
import SocialLinks from "../components/SocialLinks.astro";
import Pathway from "../components/Pathway.astro";
import PubItem from "../components/PubItem.astro";
import ProjectCard from "../components/ProjectCard.astro";
import { getCollection, getEntry } from "astro:content";
import { byRecency, ym } from "../lib/format";

const me = (await getEntry("profile", "me"))!.data;
const research = (await getEntry("research", "research"))!.data;
const pubs = (await getCollection("publications")).sort(byRecency);
const featuredPubs = pubs.filter((p) => p.data.status === "published" && p.data.presentation === "oral").slice(0, 4);
const projects = (await getCollection("projects")).filter((p) => p.data.featured).slice(0, 3);
// Year-only dates ("2026") sort after dated months of the same year.
const sortKey = (d: string) => (d.length === 4 ? `${d}-00` : d);
const news = (await getCollection("news")).sort((a, b) => sortKey(b.data.date).localeCompare(sortKey(a.data.date))).slice(0, 5);
const underReview = pubs.filter((p) => p.data.status !== "published").length;

const stats = [
  { value: String(me.stats.papers), label: "peer-reviewed papers" },
  { value: me.stats.citations, label: "citations" },
  { value: String(me.stats.h_index), label: "h-index" },
  { value: String(underReview), label: "manuscripts in review" },
];
---
<Base>
  <script is:inline>
    // The old one-page site linked to sections by hash; send those links to the new pages.
    (function () {
      var map = {
        education: "/experience/#edu-h", experience: "/experience/", skills: "/experience/#skills-h",
        interests: "/experience/#skills-h", projects: "/projects/", research: "/research/",
        team: "/research/#committee-h", publications: "/publications/", conferences: "/publications/?kind=conference",
        journals: "/publications/?kind=journal", "under-review": "/publications/#review-h", services: "/service/",
        reviewer: "/service/#review-h", certifications: "/service/#certs-h", awards: "/service/#awards-h",
        participations: "/service/#events-h"
      };
      var t = map[location.hash.slice(1)];
      if (t) location.replace(t);
    })();
  </script>
  <!-- Hero -->
  <section class="border-b border-border">
    <div class="container-page grid gap-10 py-14 md:grid-cols-[1fr_auto] md:items-center md:py-20">
      <div class="max-w-2xl">
        <p class="eyebrow">{me.role}</p>
        <h1 class="mt-3 text-4xl font-semibold sm:text-5xl">{me.name}</h1>
        <p class="mt-3 text-xl text-ink-2 font-serif">{me.headline}</p>
        <p class="mt-5 text-[1.0625rem] text-ink-2 prose-measure">{me.summary}</p>
        <div class="mt-7 flex flex-wrap gap-3">
          <a href="/research/" class="btn btn-primary">Explore my research</a>
          <a href={me.documents.research_resume} class="btn" target="_blank" rel="noopener"><Icon name="file-text" />Research CV</a>
          <a href="/contact/" class="btn"><Icon name="mail" />Contact</a>
        </div>
        <div class="mt-6"><SocialLinks links={me.links} size="sm" /></div>
      </div>
      <img src="/img/Shareef.png" alt={`Portrait of ${me.name}`} width="220" height="220"
           class="hidden h-56 w-56 rounded-full border border-border object-cover shadow-card md:block" loading="eager" />
    </div>
  </section>

  <!-- Stats -->
  <section aria-labelledby="stats-h" class="container-page py-10">
    <h2 id="stats-h" class="sr-only">At a glance</h2>
    <dl class="grid grid-cols-2 gap-3 md:grid-cols-4">
      {stats.map((s) => (
        <div class="card p-5">
          <dt class="text-sm text-muted">{s.label}</dt>
          <dd class="mt-1 font-serif text-3xl font-semibold text-ink">{s.value}</dd>
        </div>
      ))}
    </dl>
    <p class="mt-2 text-xs text-muted">Citation metrics from {me.stats.source}, {me.stats.as_of}.</p>
  </section>

  <!-- Research pathway -->
  <section aria-labelledby="pathway-h" class="container-page py-10">
    <p class="eyebrow">Doctoral research</p>
    <h2 id="pathway-h" class="mt-2 text-3xl font-semibold">From perception to clinical reasoning</h2>
    <p class="mt-3 text-ink-2 prose-measure">{research.dissertation.summary}</p>
    <div class="mt-8"><Pathway stages={research.dissertation.stages} /></div>
    <a href="/research/" class="mt-6 inline-flex items-center gap-1 font-semibold">Read about the dissertation <Icon name="arrow-up-right" size={16} /></a>
  </section>

  <!-- Featured publications -->
  <section aria-labelledby="pubs-h" class="container-page py-10">
    <div class="flex items-end justify-between gap-4">
      <div>
        <p class="eyebrow">Selected work</p>
        <h2 id="pubs-h" class="mt-2 text-3xl font-semibold">Oral presentations</h2>
      </div>
      <a href="/publications/" class="hidden font-semibold sm:inline">All publications →</a>
    </div>
    <div class="mt-4 divide-y divide-border">
      {featuredPubs.map((p) => <PubItem pub={p} />)}
    </div>
    <a href="/publications/" class="mt-2 inline-block font-semibold sm:hidden">All publications →</a>
  </section>

  <!-- Featured projects -->
  <section aria-labelledby="proj-h" class="container-page py-10">
    <div class="flex items-end justify-between gap-4">
      <div>
        <p class="eyebrow">Building</p>
        <h2 id="proj-h" class="mt-2 text-3xl font-semibold">Featured projects</h2>
      </div>
      <a href="/projects/" class="hidden font-semibold sm:inline">All projects →</a>
    </div>
    <div class="mt-6 grid gap-4 md:grid-cols-3">
      {projects.map((p) => <ProjectCard project={p} />)}
    </div>
  </section>

  <!-- News -->
  <section aria-labelledby="news-h" class="container-page py-10">
    <p class="eyebrow">Latest</p>
    <h2 id="news-h" class="mt-2 text-3xl font-semibold">News</h2>
    <ol class="mt-6 grid gap-3">
      {news.map((n) => (
        <li class="grid grid-cols-[6.5rem_1fr] gap-4 border-l-2 border-accent pl-4">
          <span class="text-sm font-semibold text-muted">{ym(n.data.date)}</span>
          <span class="text-ink-2">{n.data.text}</span>
        </li>
      ))}
    </ol>
  </section>
</Base>
