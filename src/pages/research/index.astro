---
import Base from "../../layouts/Base.astro";
import PageHeader from "../../components/PageHeader.astro";
import PersonCard from "../../components/PersonCard.astro";
import Section from "../../components/Section.astro";
import Icon from "../../components/Icon.astro";
import { getCollection, getEntry } from "astro:content";
import { getPublications } from "../../lib/pubs";
import { STATUS_LABEL, byOrder } from "../../lib/format";

const me = (await getEntry("profile", "me"))!.data;
const { dissertation: diss, thesis, themes } = (await getEntry("research", "research"))!.data;
const people = (await getCollection("people")).sort(byOrder);
const committee = people.filter((p) => p.data.group === "committee");
const collaborators = people.filter((p) => p.data.group === "collaborator");
const pubs = await getPublications();

// Link each pathway method to the paper(s) whose title names it. Some papers are titled without the
// method's acronym; these aliases come from the dissertation and research statement.
const ALIASES: Record<string, string[]> = {
  DCAN: ["Dynamic Contextual Attention Network"],
  "CAP-WAE": ["Ordinal Label-Distribution Learning with Constrained Asymmetric Priors"],
  DELTA: ["Claims You Can See"],
};
const norm = (s: string) => s.toLowerCase().replace(/[^a-z0-9²]+/g, "");
const papersFor = (method: string) =>
  pubs.filter((p) => [method, ...(ALIASES[method] ?? [])].some((m) => norm(p.data.title).includes(norm(m))));
const shortVenue = (v: string) => v.replace(/^Proceedings of (the )?/i, "");
const stages = diss.stages.map((s) => ({
  ...s,
  methods: s.methods.map((m) => ({ name: m, papers: papersFor(m) })),
}));
---
<Base title="Research" description={diss.summary}>
  <PageHeader title="Research"
    lead="Multimodal medical AI that reasons the way clinicians read a study: locate the evidence, characterize it, weigh it against context, compare it with prior exams, and commit to a claim that can be checked against the image." />

  <Section id="diss-h" title="Ph.D. dissertation" description="Georgia State University, Department of Computer Science.">
    <h3 class="font-display text-[1.625rem] leading-snug sm:text-[2rem]">{diss.title}</h3>
    <dl class="mt-6 grid gap-x-8 gap-y-3 border-t border-border pt-5 text-[1.0625rem] sm:grid-cols-[8rem_1fr]">
      <dt class="text-muted">Status</dt><dd class="text-ink">{diss.status}</dd>
      <dt class="text-muted">Advisor</dt><dd class="text-ink">Dr. {diss.advisor}</dd>
      <dt class="text-muted">Scope</dt>
      <dd class="text-ink tabular">{diss.scale.domains} clinical domains · {diss.scale.benchmarks} benchmarks · {diss.scale.architectures} architectures</dd>
    </dl>
    <p class="mt-6 max-w-[66ch] text-[1.0625rem] leading-relaxed text-ink-2">{diss.summary}</p>
    <div class="mt-6 flex flex-wrap gap-2">
      <a href={me.documents.research_statement} target="_blank" rel="noopener" class="btn btn-primary"><Icon name="file-text" size={15} />Research statement</a>
      <a href="#committee-h" class="btn">Committee</a>
    </div>
  </Section>

  <Section id="path-h" title="Interpretation pathway" description="Five stages, one question each. Every method below maps to a dissertation chapter and its papers.">
    <ol class="border-t border-border-strong">
      {stages.map((s) => (
        <li class="grid gap-4 border-b border-border py-6 md:grid-cols-[13rem_1fr] md:gap-8" id={`stage-${s.id}`}>
          <div>
            <span class="font-mono text-xs tabular text-accent-ink" aria-hidden="true">{String(s.n).padStart(2, "0")}</span>
            <h3 class="mt-1 text-[1.1875rem] font-semibold"><span class="sr-only">Stage {s.n}: </span>{s.name}</h3>
            <p class="mt-1 text-sm leading-snug text-muted">{s.question}</p>
          </div>
          <ul class="grid gap-4">
            {s.methods.map((m) => (
              <li>
                <p class="text-sm font-semibold text-ink">{m.name}</p>
                {m.papers.length > 0 ? (
                  <ul class="mt-1 grid gap-1.5">
                    {m.papers.map((p) => (
                      <li class="text-sm leading-relaxed text-ink-2">
                        {p.data.url ? <a href={p.data.url} target="_blank" rel="noopener" class="link-quiet">{p.data.title}</a> : <span class="text-ink">{p.data.title}</span>}
                        <span class="text-muted"> · {p.data.status === "published" ? shortVenue(p.data.venue) : STATUS_LABEL[p.data.status]}</span>
                      </li>
                    ))}
                  </ul>
                ) : (
                  <p class="mt-1 text-sm text-muted">Dissertation chapter; publication forthcoming.</p>
                )}
              </li>
            ))}
          </ul>
        </li>
      ))}
    </ol>
  </Section>

  <Section id="themes-h" title="Research themes" description="Threads that run through the work.">
    <div class="grid gap-8 md:grid-cols-3 md:gap-6">
      {themes.map((t) => (
        <article class="border-t-2 border-ink pt-4">
          <h3 class="text-[1.0625rem] font-semibold">{t.title}</h3>
          <p class="mt-2 text-sm leading-relaxed text-ink-2">{t.text}</p>
        </article>
      ))}
    </div>
  </Section>

  <Section id="committee-h" title="Dissertation committee">
    <div class="grid gap-x-8 gap-y-8 sm:grid-cols-2 xl:grid-cols-3">
      {committee.map((p) => <PersonCard person={p} />)}
    </div>
  </Section>

  <Section id="thesis-h" title={`M.S. thesis, ${thesis.year}`} description={`Advisor: Dr. ${thesis.advisor}. Georgia State University.`}>
    <h3 class="font-display text-[1.5rem] leading-snug sm:text-[1.75rem]">{thesis.title}</h3>
    <p class="mt-4 max-w-[66ch] text-[1.0625rem] leading-relaxed text-ink-2">{thesis.summary}</p>
    <div class="mt-6 flex flex-wrap gap-2">
      {thesis.links.map((l, i) => (
        <a href={l.url} target="_blank" rel="noopener" class:list={["btn", i === 0 && "btn-primary"]}>
          <Icon name={i === 0 ? "file-text" : "arrow-up-right"} size={15} />{l.label}
        </a>
      ))}
    </div>
  </Section>

  <Section id="collab-h" title="Collaborators">
    <div class="grid gap-x-8 gap-y-8 sm:grid-cols-2">
      {collaborators.map((p) => <PersonCard person={p} />)}
    </div>
  </Section>
</Base>
