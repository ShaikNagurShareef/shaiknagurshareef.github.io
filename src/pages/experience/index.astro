---
import Base from "../../layouts/Base.astro";
import PageHeader from "../../components/PageHeader.astro";
import Section from "../../components/Section.astro";
import Icon from "../../components/Icon.astro";
import { getCollection, getEntry } from "astro:content";
import { range, byOrder } from "../../lib/format";

const me = (await getEntry("profile", "me"))!.data;
const byStart = <T extends { data: { start: string } }>(a: T, b: T) => b.data.start.localeCompare(a.data.start);
const jobs = (await getCollection("experience")).sort(byStart);
const schools = (await getCollection("education")).sort((a, b) => b.data.end.localeCompare(a.data.end));
const skills = (await getCollection("skills")).sort(byOrder);
---
<Base title="Experience" description="Research and industry experience: Georgia State University, UST, Carelon Global Solutions and Tata Consultancy Services.">
  <PageHeader title="Experience"
    lead="Doctoral research at Georgia State University's TReNDS Center, alongside industry roles building and shipping ML, analytics and agentic systems at UST, Carelon and TCS.">
    <a href={me.documents.resume} target="_blank" rel="noopener" class="btn btn-primary"><Icon name="download" size={15} />Resume (PDF)</a>
    <a href={me.links.linkedin!} target="_blank" rel="noopener" class="btn"><Icon name="arrow-up-right" size={15} />LinkedIn</a>
  </PageHeader>

  <Section id="work-h" title="Work">
    <ol class="rows -mt-6">
      {jobs.map((j) => (
        <li class="grid gap-2 py-6 md:grid-cols-[10rem_1fr] md:gap-8">
          <p class="text-sm tabular text-muted md:pt-0.5">
            {range(j.data.start, j.data.end)}
            {!j.data.end && <span class="badge badge-ok ml-2 md:ml-0 md:mt-2 md:flex md:w-fit">Current</span>}
          </p>
          <div>
            <h3 class="text-base font-semibold">{j.data.role}</h3>
            <p class="mt-0.5 text-[0.9375rem] text-ink-2">
              {j.data.orgUrl ? <a href={j.data.orgUrl} target="_blank" rel="noopener">{j.data.org}</a> : j.data.org}
              <span class="text-muted"> · {j.data.location}</span>
            </p>
            <ul class="mt-3 grid list-disc gap-1.5 pl-4 text-[0.9375rem] leading-relaxed text-ink-2 marker:text-border-strong prose-measure">
              {j.data.highlights.map((h) => <li>{h}</li>)}
            </ul>
          </div>
        </li>
      ))}
    </ol>
  </Section>

  <Section id="edu-h" title="Education">
    <ol class="rows -mt-6">
      {schools.map((s) => (
        <li class="grid gap-2 py-6 md:grid-cols-[10rem_1fr] md:gap-8">
          <p class="text-sm tabular text-muted md:pt-0.5">{range(s.data.start, s.data.end, s.data.expected)}</p>
          <div>
            <h3 class="text-base font-semibold">{s.data.degree}</h3>
            <p class="mt-0.5 text-[0.9375rem] text-ink-2">
              {s.data.schoolUrl ? <a href={s.data.schoolUrl} target="_blank" rel="noopener">{s.data.school}</a> : s.data.school}
              <span class="text-muted"> · {s.data.location} · GPA {s.data.gpa}</span>
            </p>
            {s.data.note && <p class="mt-2 text-[0.9375rem] text-ink-2 prose-measure">{s.data.note}</p>}
            <p class="mt-3 text-sm leading-relaxed text-muted prose-measure"><span class="font-medium text-ink-2">Coursework:</span> {s.data.coursework.join(", ")}</p>
          </div>
        </li>
      ))}
    </ol>
  </Section>

  <Section id="skills-h" title="Skills">
    <dl class="rows -mt-3">
      {skills.map((g) => (
        <div class="grid gap-1 py-3 md:grid-cols-[10rem_1fr] md:gap-8">
          <dt class="text-sm font-semibold text-ink">{g.data.group}</dt>
          <dd class="text-sm leading-relaxed text-ink-2">{g.data.items.join(" · ")}</dd>
        </div>
      ))}
    </dl>
  </Section>
</Base>
