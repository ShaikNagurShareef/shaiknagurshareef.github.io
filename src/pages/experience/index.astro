---
import Base from "../../layouts/Base.astro";
import PageHeader from "../../components/PageHeader.astro";
import Section from "../../components/Section.astro";
import Icon from "../../components/Icon.astro";
import { getCollection, getEntry } from "astro:content";
import { range, byOrder } from "../../lib/format";

const me = (await getEntry("profile", "me"))!.data;
const byStart = <T extends { data: { start: string } }>(a: T, b: T) => b.data.start.localeCompare(a.data.start);
const jobs = (await getCollection("experience")).sort(byStart);
const schools = (await getCollection("education")).sort((a, b) => b.data.end.localeCompare(a.data.end));
const skills = (await getCollection("skills")).sort(byOrder);
---
<Base title="Experience" description="Research and industry experience: Georgia State University, UST, Carelon Global Solutions and Tata Consultancy Services.">
  <PageHeader title="Experience"
    lead="Doctoral research at Georgia State University's TReNDS Center, alongside industry roles building and shipping ML, analytics and agentic systems at UST, Carelon and TCS.">
    <a href={me.documents.resume} target="_blank" rel="noopener" class="btn btn-primary"><Icon name="download" size={15} />Resume (PDF)</a>
    <a href={me.links.linkedin!} target="_blank" rel="noopener" class="btn">LinkedIn</a>
  </PageHeader>

  <Section id="work-h" title="Work">
    <ol class="timeline -mt-6">
      {jobs.map((j, i) => (
        <li class:list={["grid gap-2 py-6 md:grid-cols-[10rem_1fr] md:gap-8", !j.data.end && "is-current"]} style={`--i:${i}`}>
          <span class="tl-dot" aria-hidden="true"></span>
          <p class="mono text-muted md:pt-1">
            {range(j.data.start, j.data.end)}
            {!j.data.end && <span class="badge badge-ok ml-2 md:ml-0 md:mt-2 md:flex md:w-fit">Current</span>}
          </p>
          <div>
            <h3 class="text-[1.1875rem] font-semibold">{j.data.role}</h3>
            <p class="mt-0.5 text-[1.0625rem] text-ink-2">
              {j.data.orgUrl ? <a href={j.data.orgUrl} target="_blank" rel="noopener" class="link-quiet">{j.data.org}</a> : j.data.org}
              <span class="text-muted"> · {j.data.location}</span>
            </p>
            <ul class="mt-3 grid list-disc gap-1.5 pl-4 text-[1.0625rem] leading-relaxed text-ink-2 marker:text-border-strong prose-measure">
              {j.data.highlights.map((h) => <li>{h}</li>)}
            </ul>
          </div>
        </li>
      ))}
    </ol>
  </Section>

  <Section id="edu-h" title="Education">
    <ol class="timeline -mt-6">
      {schools.map((s, i) => (
        <li class:list={["grid gap-2 py-6 md:grid-cols-[10rem_1fr] md:gap-8", s.data.expected && "is-current"]} style={`--i:${i}`}>
          <span class="tl-dot" aria-hidden="true"></span>
          <p class="mono text-muted md:pt-1">{range(s.data.start, s.data.end, s.data.expected)}</p>
          <div>
            <h3 class="text-[1.1875rem] font-semibold">{s.data.degree}</h3>
            <p class="mt-0.5 text-[1.0625rem] text-ink-2">
              {s.data.schoolUrl ? <a href={s.data.schoolUrl} target="_blank" rel="noopener" class="link-quiet">{s.data.school}</a> : s.data.school}
              <span class="text-muted"> · {s.data.location} · GPA {s.data.gpa}</span>
            </p>
            {s.data.note && <p class="mt-2 text-[1.0625rem] text-ink-2 prose-measure">{s.data.note}</p>}
            <p class="mt-3 text-sm leading-relaxed text-muted prose-measure"><span class="font-medium text-ink-2">Coursework:</span> {s.data.coursework.join(", ")}</p>
          </div>
        </li>
      ))}
    </ol>
  </Section>

  <Section id="skills-h" title="Skills">
    <dl class="rows -mt-3">
      {skills.map((g) => (
        <div class="grid gap-1 py-3 md:grid-cols-[10rem_1fr] md:gap-8">
          <dt class="text-sm font-semibold text-ink">{g.data.group}</dt>
          <dd class="text-sm leading-relaxed text-ink-2">{g.data.items.join(" · ")}</dd>
        </div>
      ))}
    </dl>
  </Section>
</Base>

<style>
  /* Timeline rail: a line between the date column and the details, one marker per entry. */
  .timeline { position: relative; }
  .timeline > li { position: relative; padding-left: 1.75rem; }
  .timeline > li + li { border-top: 1px solid var(--border); }
  .timeline > li::before { content: ""; position: absolute; left: 5px; top: 0; bottom: 0; width: 1px; background: var(--border-strong); }
  .timeline > li:first-child::before { top: 2rem; }
  .timeline > li:last-child::before { bottom: auto; height: 2rem; }
  .tl-dot {
    position: absolute; left: 0; top: 1.85rem; width: 11px; height: 11px; border-radius: 999px;
    background: var(--bg); border: 2px solid var(--ink-2); box-shadow: 0 0 0 4px var(--bg);
  }
  .is-current > .tl-dot { background: var(--ink); border-color: var(--ink); }
  @media (min-width: 768px) {
    .timeline > li { padding-left: 0; }
    .timeline > li::before { left: calc(10rem + 1rem); }
    .tl-dot { left: calc(10rem + 1rem - 5px); }
    .timeline > li > :global(div) { padding-left: 1rem; }
  }
  @media (prefers-reduced-motion: no-preference) {
    :global(.js) .tl-dot { transform: scale(0.4); opacity: 0; transition: transform 400ms cubic-bezier(0.2, 0.7, 0.2, 1), opacity 400ms; transition-delay: calc(var(--i) * 120ms + 200ms); }
    :global(.js .is-visible) .tl-dot { transform: none; opacity: 1; }
  }
</style>
